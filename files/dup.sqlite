CREATE INDEX 'crc32' ON 'files' (`crc32` DESC);
CREATE INDEX 'file' ON 'files' (`file` DESC);
CREATE INDEX 'size' ON 'files' (`size` DESC);
CREATE UNIQUE INDEX 'file_2' ON 'files' (`file` DESC,`profile` DESC);
CREATE UNIQUE INDEX 'name' ON 'profiletypes' (`name` DESC);
CREATE UNIQUE INDEX 'profile' ON 'viewpages' (`profile` DESC);
CREATE UNIQUE INDEX 'profile_2' ON 'status' (`profile` DESC);

CREATE UNIQUE INDEX 'file_m' ON 'files_move' (`old` DESC,`profile` DESC);
CREATE UNIQUE INDEX 'file_d' ON 'files_delete' (`old` DESC,`profile` DESC);
CREATE UNIQUE INDEX 'file_r' ON 'files_rename' (`old` DESC,`profile` DESC);
CREATE UNIQUE INDEX 'file_l' ON 'files_link' (`new` DESC,`profile` DESC);
CREATE UNIQUE INDEX 'name_a' ON 'accounts' (`name` DESC);

COMMIT;










