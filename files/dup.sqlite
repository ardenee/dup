BEGIN TRANSACTION;
CREATE TABLE `profiletypes` (`id` INTEGER PRIMARY KEY AUTOINCREMENT ,`exts` TEXT ,`name` VARCHAR(50));
CREATE TABLE `files` (`id` INTEGER PRIMARY KEY AUTOINCREMENT,`file` VARCHAR(255) ,`size` FLOAT(0,0) DEFAULT 0 ,`fdate` DATETIME DEFAULT CURRENT_TIMESTAMP ,`crc32` VARCHAR(15),`profile` INT NOT NULL,`link` VARCHAR(255) );
CREATE TABLE `logs` (`id` INTEGER PRIMARY KEY AUTOINCREMENT,`stamp` DATETIME DEFAULT CURRENT_TIMESTAMP ,`str` TEXT ,`type` INT DEFAULT 1 ,`page` VARCHAR(255) ,`line` INT DEFAULT 0 ,`function` VARCHAR(255) );
CREATE TABLE `profiles` (`id` INTEGER PRIMARY KEY AUTOINCREMENT ,`msize` INT DEFAULT 0 ,`path` VARCHAR(255) ,`mpath` VARCHAR(255) ,`crc32` VARCHAR(15),`filetypes` TEXT ,`scan` SMALLINT DEFAULT 0 ,`lastrun` DATETIME DEFAULT CURRENT_TIMESTAMP ,`type` INT DEFAULT 1,`files` INT DEFAULT 0,`dups` INT DEFAULT 0,`runs` INT DEFAULT 0);
CREATE TABLE `settings` (`id` INTEGER PRIMARY KEY AUTOINCREMENT ,`renametype` INT DEFAULT 0,`namecleanup` INT DEFAULT 0,`cleanupfilter` TEXT ,`dot` INT  DEFAULT 0,`under` INT DEFAULT 0,`doubleb` INT DEFAULT 0,`flatfolders` INT DEFAULT 0,`logs` INT DEFAULT 0,`displaymoved` INT DEFAULT 0,`cpfolder` INT DEFAULT 0,`shortfilenames` INT DEFAULT 0,`runtime` INT DEFAULT 3600,`version` VARCHAR(15) ,`ifolders` TEXT,`download` INT DEFAULT 0);
CREATE TABLE `status` (`id` INTEGER PRIMARY KEY AUTOINCREMENT ,`value` TEXT ,`data` TEXT ,`profile` INT NOT NULL );
CREATE TABLE `viewpages` (`id` INTEGER PRIMARY KEY AUTOINCREMENT ,`data` TEXT ,`profile` INT NOT NULL );
CREATE TABLE `msg` (`id` INTEGER PRIMARY KEY AUTOINCREMENT ,`message` TEXT);
CREATE TABLE `files_delete` (`id` INTEGER PRIMARY KEY AUTOINCREMENT ,`old` VARCHAR(255), `new` VARCHAR(255) ,`profile` INT NOT NULL);
CREATE TABLE `files_move` (`id` INTEGER PRIMARY KEY AUTOINCREMENT ,`old` VARCHAR(255), `new` VARCHAR(255) ,`profile` INT NOT NULL);
CREATE TABLE `files_rename` (`id` INTEGER PRIMARY KEY AUTOINCREMENT ,`old` VARCHAR(255), `new` VARCHAR(255) ,`profile` INT NOT NULL);
CREATE TABLE `files_link` (`id` INTEGER PRIMARY KEY AUTOINCREMENT ,`old` VARCHAR(255), `new` VARCHAR(255) ,`profile` INT NOT NULL);
CREATE TABLE `accounts` (`id` INTEGER PRIMARY KEY AUTOINCREMENT ,`name` VARCHAR(50), `level` INT NOT NULL, `password` VARCHAR(50));

