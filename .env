# Public defaults only. Put APP_SECRET, DB credentials and production values
# into an ignored .env.local or host process environment, NEVER in source.
APP_ENV=dev
APP_SECRET=
# Semicolon-separated server directories; e.g. D:\\Music on Windows, /srv/media on Linux or /volume1/Music on DSM.
# Empty by default: do not disclose the webserver filesystem.
DUP_ALLOWED_SCAN_ROOTS=
DEFAULT_URI=http://127.0.0.1:8088
DATABASE_URL="sqlite:///%kernel.project_dir%/var/dup_dev.sqlite"
