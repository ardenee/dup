{% extends 'base.html.twig' %}
{% from '_table_headers.html.twig' import sort as sort_heading %}
{% from 'duplicates/_format.html.twig' import bytes %}
{% block title %}Job #{{ job.id }}{% endblock %}
{% block section %}Job monitor / #{{ job.id }}{% endblock %}
{% block body %}
<div class="page-heading">
  <div>
    <div class="eyebrow">BACKGROUND JOB DETAILS</div>
    <h1>Job #{{ job.id }}</h1>
    <p class="muted">{{ job.kind|replace({'_':' ','-':' '})|capitalize }} ·
      {{ job.profile_name ?? 'Profile removed' }} ·
      <span class="status">{{ job.state|replace({'_':' '}) }}</span></p>
  </div>
  <a class="secondary link-button" href="{{ path('app_jobs') }}">Back to job monitor</a>
</div>
<div class="stats-grid">
  <div class="stat"><span>Status</span><strong>{{ job.state|capitalize }}</strong></div>
  <div class="stat"><span>Current stage</span><strong>{{ job.phase|replace({'_':' '})|capitalize }}</strong></div>
  <div class="stat"><span>Progress</span><strong>{{ job.progress_current|number_format }}{% if job.progress_total is not null %} / {{ job.progress_total|number_format }}{% endif %}</strong><small>Completed files / candidate files</small></div>
  {% if job.progress_bytes_total is not null %}
    <div class="stat"><span>Bytes read</span><strong>{{ bytes(job.progress_bytes_current|default(0)) }} / {{ bytes(job.progress_bytes_total) }}</strong>
      <small>{{ job.progress_detail|default('') }}</small>
      <progress max="{{ job.progress_bytes_total > 0 ? job.progress_bytes_total : 1 }}"
          value="{{ job.progress_bytes_current|default(0) }}"></progress></div>
  {% endif %}
</div>
<section class="panel">
  <div class="panel-heading"><h2>Job information</h2></div>
  <dl class="details">
    <div><dt>Created</dt><dd>{{ job.created_at }} UTC</dd></div>
    <div><dt>Started</dt><dd>{{ job.started_at ? job.started_at ~ ' UTC' : 'Not started' }}</dd></div>
    <div><dt>Finished</dt><dd>{{ job.finished_at ? job.finished_at ~ ' UTC' : 'Not finished' }}</dd></div>
    <div><dt>Last heartbeat</dt><dd>{{ job.heartbeat_at ? job.heartbeat_at ~ ' UTC' : 'No heartbeat' }}</dd></div>
    {% if job.last_progress_at %}
      <div><dt>Last byte progress</dt><dd>{{ job.last_progress_at }} UTC</dd></div>
    {% endif %}
    {% if job.progress_detail %}
      <div><dt>Processing</dt><dd>{{ job.progress_detail }}</dd></div>
    {% endif %}
    <div><dt>Attempts</dt><dd>{{ job.attempts|default(0) }}</dd></div>
    <div><dt>Error code</dt><dd>{{ job.error_code ?? 'None recorded' }}</dd></div>
    {% if job.last_failure_reason %}
      <div><dt>Failure details</dt><dd class="report-error">{{ job.last_failure_reason }}</dd></div>
    {% endif %}
  </dl>
  <div class="panel-content">
    <div class="profile-page-actions">
      {% if job.run_id %}
        <a class="secondary link-button" href="{{ path('app_report_run',{id:job.run_id}) }}">Scan report #{{ job.run_id }}</a>
        {% if job.run_state in ['completed','archived'] %}
          <a class="primary link-button" href="{{ path('app_duplicates',{run:job.run_id}) }}">View duplicate results</a>
        {% endif %}
      {% endif %}
      {% if job.file_action_batch_id %}
        <a class="secondary link-button" href="{{ path('app_action_detail',{id:job.file_action_batch_id}) }}">Review file action / restore</a>
      {% endif %}
      {% set cancellable = job.state == 'queued' or (job.state == 'running' and job.kind in ['scan','rebuild-duplicates','duplicate-verify']) %}
      {% if cancellable %}
        <form method="post" action="{{ path('app_job_cancel',{id:job.id}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('cancel_job_' ~ job.id) }}">
          <input type="hidden" name="return_to" value="detail">
          <button class="secondary" type="submit">Cancel job</button>
        </form>
      {% elseif job.state == 'cancelling' %}
        <span class="status">Cancellation requested — awaiting worker acknowledgement</span>
      {% elseif job.state == 'running' and job.kind not in ['scan','rebuild-duplicates','duplicate-verify'] %}
        <span class="muted">File operations cannot be interrupted during execution.</span>
      {% endif %}
    </div>
  </div>
</section>
{% if job.state in ['running','cancelling'] and job.kind in ['scan','rebuild-duplicates','duplicate-verify'] %}
<section class="panel panel-content" id="resolve-stalled">
  <h2>{{ job.state == 'cancelling' ? 'Finish an unresponsive cancellation' : 'Resolve an unresponsive job' }}</h2>
  <p>A cancellation request asks the worker to stop at its next checkpoint.
    If the worker is hung or has exited, the job can remain in this state indefinitely.</p>
  {% set overdue = job.heartbeat_at is null or job.heartbeat_at < stale_cutoff|default('') %}
  {% set owner_idle = not job_owner_active|default(false) %}
  {% if not overdue %}
    <p class="notice notice-warning">The last heartbeat is less than 10 minutes old.
      Try refreshing the Job Monitor and allow cooperative cancellation to finish.</p>
  {% elseif not owner_idle %}
    <p class="notice notice-warning">The worker that originally claimed this job is still
      reporting. Resolve is blocked until that process stops or acknowledges cancellation.</p>
  {% else %}
    <p class="notice notice-warning"><strong>Worker heartbeat expired.</strong>
      This does not prove the operating-system process has exited. Before resolving, verify
      that the DUP worker process/service is stopped (on DSM, use Package Center).
      Otherwise its file read may still be in progress.
      The operation below releases the database lease; it does not kill the process.
      No source file is deleted and stored scan results remain untouched.</p>
    <form method="post" action="{{ path('app_job_resolve',{id:job.id}) }}"
        onsubmit="return confirm('Have you stopped the old DUP worker process? Resolve job #{{ job.id }} as {{ job.state == 'cancelling' ? 'cancelled' : 'failed' }} and release its database lease?')">
      <input type="hidden" name="_token" value="{{ csrf_token('resolve_stale_job_' ~ job.id) }}">
      <input type="hidden" name="confirm" value="RESOLVE">
      <button class="secondary" type="submit">{{ job.state == 'cancelling' ? 'Finish stalled cancellation' : 'Resolve stalled job' }}</button>
    </form>
  {% endif %}
</section>
{% endif %}
{% if job.state == 'failed' and job.error_code == 'WORKER_STALLED' %}
<section class="notice notice-warning job-diagnostic-note">
  <strong>Worker timeout, not a verified hash failure.</strong>
  No heartbeat was observed within the recovery window. This alone cannot establish
  whether the process was stopped, a storage read blocked, or the worker became unreachable.
  The last recorded file and byte counts above are evidence, not a completion estimate.
  Inspect the DUP worker service log and <a href="{{ path('app_system') }}">System health</a>
  before retrying.
  {% if is_dsm|default(false) %}
    <p>Synology worker log: <code>/var/packages/dup/var/worker.log</code></p>
  {% endif %}
</section>
{% endif %}
{% if job.state in ['failed','cancelled'] and job.kind in ['scan','duplicate-verify'] %}
<section class="panel panel-content">
  <h2>Retry this operation</h2>
  <p>Retry creates a new job. The original job and diagnostic events remain in history.</p>
  <form method="post" action="{{ path('app_job_retry',{id:job.id}) }}"
        onsubmit="return confirm('Queue a new {{ job.kind == 'scan' ? 'scan' : 'SHA-256 verification' }} job?')">
    <input type="hidden" name="_token" value="{{ csrf_token('retry_job_' ~ job.id) }}">
    <button type="submit" class="primary">Retry {{ job.kind == 'scan' ? 'scan' : 'SHA-256 verification' }}</button>
  </form>
</section>
{% endif %}
{% if cleanup.can_remove %}
<section class="panel panel-content" id="remove-job">
  <h2>Remove this old job log</h2>
  <p>This removes job #{{ job.id }} and its {{ cleanup.events|number_format }} event records.
    The scan result, stored file index and duplicate groups are retained.
    This action cannot be undone.</p>
  <form method="post" action="{{ path('app_job_remove',{id:job.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('remove_job_' ~ job.id) }}">
    <input type="hidden" name="confirm" value="DELETE">
    <button class="secondary" type="submit"
      onclick="return confirm('Delete this completed job log and its events? Scan results will remain available.')">
      Delete job and events
    </button>
  </form>
</section>
{% elseif cleanup.blocked_reason and job.state not in ['queued','running','cancelling'] %}
  <div class="notice notice-warning">Removing this job log is unavailable:
    {{ cleanup.blocked_reason }}</div>
{% endif %}
<section class="panel">
  <div class="panel-heading"><div><h2>Job events and errors</h2>
    <p class="muted">Sort and filter every recorded event, including older pages. Details are displayed below instead of raw JSON.</p>
  </div></div>
  <form method="get" action="{{ path('app_job_detail',{id:job.id}) }}" class="table-event-filter">
    <label for="job-event-severity">Event severity</label>
    <select name="severity" id="job-event-severity">
      <option value="">All severities</option>
      {% for value in ['info','warning','error'] %}
        <option value="{{ value }}" {{ event_severity|default('') == value ? 'selected' : '' }}>{{ value|capitalize }}</option>
      {% endfor %}
    </select>
    <input type="hidden" name="sort" value="{{ event_sort|default('id') }}">
    <input type="hidden" name="dir" value="{{ event_dir|default('desc') }}">
    <button type="submit" class="secondary">Filter events</button>
    <a class="secondary link-button" href="{{ path('app_job_detail',{id:job.id}) }}">Clear</a>
  </form>
  {% if events is empty %}
    <div class="empty-state">No events match this selection. Change the severity filter or inspect the job status above.</div>
  {% else %}
    <div class="table-wrap">
      <table>
        <thead><tr>
          {{ sort_heading('app_job_detail',event_filters|default({id:job.id}),event_sort|default('id'),event_dir|default('desc'),'when','When (UTC)') }}
          {{ sort_heading('app_job_detail',event_filters|default({id:job.id}),event_sort|default('id'),event_dir|default('desc'),'severity','Severity') }}
          {{ sort_heading('app_job_detail',event_filters|default({id:job.id}),event_sort|default('id'),event_dir|default('desc'),'code','Event') }}
          <th>Details</th></tr></thead>
        <tbody>{% for event in events %}
          <tr>
            <td>{{ event.created_at }}</td>
            <td><span class="status">{{ event.severity|capitalize }}</span></td>
            <td><strong>{{ event.code|replace({'_':' '}) }}</strong></td>
            <td>
              {% if event.fields is not empty %}
                {% for key,value in event.fields %}
                  <div class="job-event-field"><strong>{{ key|replace({'_':' '}) }}</strong>:
                    <span>{{ value is iterable ? value|json_encode : value }}</span></div>
                {% endfor %}
              {% else %}
                <span class="muted">No additional details</span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}</tbody>
      </table>
    </div>
    <div class="result-toolbar">
      <span>Showing {{ events|length }} of {{ event_total|default(events|length)|number_format }} matching events (100 per page)</span>
      <nav aria-label="Job event pages">
        {% if previous %}<a href="{{ path('app_job_detail',event_filters|default({id:job.id})|merge({after:previous})) }}">Previous page</a>{% endif %}
        {% if next %}<a href="{{ path('app_job_detail',event_filters|default({id:job.id})|merge({before:next})) }}">Next page</a>{% endif %}
      </nav>
    </div>
  {% endif %}
</section>
{% endblock %}
