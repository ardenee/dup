{% extends 'base.html.twig' %}
{% from '_action_icons.html.twig' import icon %}
{% from '_table_headers.html.twig' import sort as sort_heading %}
{% from 'duplicates/_format.html.twig' import bytes %}
{% block title %}Jobs{% endblock %}
{% block section %}Jobs{% endblock %}
{% block body %}
<div class="page-heading">
  <div><div class="eyebrow">SCAN & FILE OPERATIONS</div><h1>Job monitor</h1>
    <p class="muted">Find any saved job, read its event log, and open scan results or recovery details.</p>
  </div>
  <div class="profile-page-actions">
    <a class="secondary link-button" href="{{ path('app_profiles') }}">Scan profiles</a>
    <a class="secondary link-button" href="{{ path('app_duplicates') }}">Browse duplicates</a>
    <a class="secondary link-button" href="{{ path('app_worker_log') }}">Worker diagnostics</a>
    <a class="secondary link-button" href="{{ path('app_job_cleanup') }}">Clean old jobs</a>
  </div>
</div>
<section class="panel">
  <form method="get" action="{{ path('app_jobs') }}" class="job-filter">
    <div class="field">
      <label for="job-profile">Profile</label>
      <select id="job-profile" name="profile">
        <option value="">All profiles</option>
        {% for p in profiles %}
          <option value="{{ p.id }}" {{ selected_profile == p.id ? 'selected' : '' }}>{{ p.name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="field">
      <label for="job-state">Job status</label>
      <select id="job-state" name="state">
        <option value="">All statuses</option>
        {% for name in ['queued','running','cancelling','completed','failed','cancelled'] %}
          <option value="{{ name }}" {{ selected_state == name ? 'selected' : '' }}>{{ name|capitalize }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="field">
      <label for="job-kind">Job type</label>
      <select id="job-kind" name="kind">
        <option value="">All types</option>
        {% for name in job_kinds|default([]) %}
          <option value="{{ name }}" {{ selected_kind|default('') == name ? 'selected' : '' }}>
            {{ name|replace({'-':' ','_':' '})|capitalize }}
          </option>
        {% endfor %}
      </select>
    </div>
    <input type="hidden" name="sort" value="{{ sort|default('id') }}">
    <input type="hidden" name="dir" value="{{ dir|default('desc') }}">
    <div class="job-filter-actions">
      <button class="primary" type="submit">Filter jobs</button>
      <a class="secondary link-button" href="{{ path('app_jobs') }}">Clear</a>
    </div>
  </form>
</section>
<section class="panel">
  <div class="panel-heading">
    <div><h2>Job history</h2><p class="muted">50 jobs per page. Sort and filter all matching jobs. Use the stop icon to request cancellation, the recovery icon to resolve an overdue job, and the trash icon to delete finished job history.</p></div>
    <div class="job-monitor-links">
      <span class="muted">{{ page.total|number_format }} matching</span>
      <a class="secondary link-button" href="{{ path('app_job_cleanup') }}">Clean old history</a>
    </div>
  </div>
  {% if jobs is empty %}
    <div class="empty-state">No jobs match these filters.
      <a href="{{ path('app_jobs') }}">Show all jobs</a>.
    </div>
  {% else %}
    {% include 'jobs/_pager.html.twig' %}
    <div class="table-wrap">
      <table id="jobs-table">
        <thead><tr>
          {{ sort_heading('app_jobs',job_filters|default({}),sort|default('id'),dir|default('desc'),'id','Job / profile') }}
          {{ sort_heading('app_jobs',job_filters|default({}),sort|default('id'),dir|default('desc'),'type','Type') }}
          {{ sort_heading('app_jobs',job_filters|default({}),sort|default('id'),dir|default('desc'),'stage','Stage') }}
          {{ sort_heading('app_jobs',job_filters|default({}),sort|default('id'),dir|default('desc'),'status','Status') }}
          {{ sort_heading('app_jobs',job_filters|default({}),sort|default('id'),dir|default('desc'),'progress','Progress') }}
          {{ sort_heading('app_jobs',job_filters|default({}),sort|default('id'),dir|default('desc'),'heartbeat','Heartbeat') }}
          <th>Results &amp; details</th><th>Actions</th>
        </tr></thead>
        <tbody>
        {% for job in jobs %}
          <tr data-job-id="{{ job.id }}" data-rendered-state="{{ job.state }}">
            <td>
              <a class="text-link" href="{{ path('app_job_detail',{id:job.id}) }}"><strong>#{{ job.id }}</strong></a>
              <div class="muted">{{ job.profile_name ?? 'No profile' }}</div>
            </td>
            <td>{{ job.kind|replace({'_':' ','-':' '}) }}</td>
            <td data-field="phase">{{ job.phase|replace({'_':' '}) }}</td>
            <td><span class="status" data-field="state">{{ job.state }}</span></td>
            <td><div data-field="progress-text" class="muted">{{ job.progress_current|number_format }}
                {% if job.progress_total is not null %}/ {{ job.progress_total|number_format }}{% endif %}</div>
              {% if job.progress_bytes_total is not null %}
                <div class="job-byte-progress" data-field="bytes-text">
                  {{ bytes(job.progress_bytes_current|default(0)) }} / {{ bytes(job.progress_bytes_total) }} read
                </div>
                <div class="job-progress-detail" data-field="progress-detail"
                     title="{{ job.progress_detail|default('') }}">{{ job.progress_detail|default('') }}</div>
                <progress class="job-bytes-bar" data-field="bytes-bar"
                  max="{{ job.progress_bytes_total > 0 ? job.progress_bytes_total : 1 }}"
                  value="{{ job.progress_bytes_current > 0 ? job.progress_bytes_current : 0 }}"></progress>
              {% else %}
                <div data-field="bytes-text" class="job-byte-progress" hidden></div>
                <div data-field="progress-detail" class="job-progress-detail" hidden></div>
                <progress class="job-bytes-bar" data-field="bytes-bar" hidden></progress>
              {% endif %}
              <progress max="{{ job.progress_total > 0 ? job.progress_total : 1 }}"
                value="{{ job.state == 'completed' and job.progress_total > 0 ? job.progress_total : (job.progress_total > 0 and job.progress_current < job.progress_total ? job.progress_current : (job.progress_total > 0 ? job.progress_total : 0)) }}"
                data-field="progress-bar"></progress></td>
            <td data-field="heartbeat" class="muted">{{ job.heartbeat_at ? job.heartbeat_at ~ ' UTC' : '—' }}</td>
            <td>
              <div class="action-icon-group">
                <a class="action-icon-button" href="{{ path('app_job_detail',{id:job.id}) }}"
                   title="Job details and events" aria-label="Details and events for job {{ job.id }}">{{ icon('details') }}</a>
                <a class="action-icon-button" href="{{ path('app_worker_log',{job:job.id}) }}"
                   title="View detailed file debug log for job #{{ job.id }}"
                   aria-label="View debug trace for job {{ job.id }}">{{ icon('history') }}</a>
                {% if job.run_id and job.run_state in ['completed','archived'] %}
                  <a class="action-icon-button" href="{{ path('app_duplicates',{run:job.run_id}) }}"
                     title="Scan duplicate results" aria-label="Duplicate results for scan {{ job.run_id }}">{{ icon('eye') }}</a>
                {% endif %}
                {% if job.file_action_batch_id %}
                  <a class="action-icon-button" href="{{ path('app_action_detail',{id:job.file_action_batch_id}) }}"
                     title="File action and restore details" aria-label="File action details for job {{ job.id }}">{{ icon('restore') }}</a>
                {% endif %}
              </div>
              {% if job.error_code %}<div class="report-error" data-field="error">{{ job.error_code }}</div>
              {% else %}<span class="muted" data-field="error"></span>{% endif %}
            </td>
            <td>
              {% set scan_kind = job.kind in ['scan','rebuild-duplicates','duplicate-verify'] %}
              {% set is_finished = job.state in ['completed','failed','cancelled'] %}
              {% set can_remove = is_finished and job.active_profile_id is null
                and job.file_action_batch_id is null and (scan_kind or job.history_prunable_at) %}
              {% set overdue = job.heartbeat_at is null or job.heartbeat_at < stale_cutoff|default('') %}
              <div class="action-icon-group job-manage-actions" data-job-actions>
                {% if job.state == 'queued' or (job.state == 'running' and scan_kind) %}
                  <form method="post" data-job-cancel action="{{ path('app_job_cancel',{id:job.id}) }}"
                    onsubmit="return confirm('Request cancellation of job #{{ job.id }}?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_job_' ~ job.id) }}">
                    <button class="action-icon-button is-destructive" type="submit"
                      title="Request cancellation of job #{{ job.id }}" aria-label="Cancel job {{ job.id }}">{{ icon('stop') }}</button>
                  </form>
                {% endif %}
                {% if job.state in ['running','cancelling'] and scan_kind and overdue %}
                  <form method="post" data-job-resolve action="{{ path('app_job_resolve',{id:job.id}) }}"
                    onsubmit="return confirm('Confirm the original DUP worker is stopped. Resolve stalled job #{{ job.id }} and release its lease? This does not kill an OS process.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('resolve_stale_job_' ~ job.id) }}">
                    <input type="hidden" name="confirm" value="RESOLVE">
                    <button class="action-icon-button is-destructive" type="submit"
                      title="{{ job.state == 'cancelling' ? 'Finish stalled cancellation' : 'Resolve stalled job' }} #{{ job.id }}"
                      aria-label="{{ job.state == 'cancelling' ? 'Finish stalled cancellation' : 'Resolve stalled job' }} {{ job.id }}">{{ icon('restore') }}</button>
                  </form>
                {% endif %}
                {% if job.state in ['failed','cancelled'] and job.kind in ['scan','duplicate-verify'] %}
                  <form method="post" action="{{ path('app_job_retry',{id:job.id}) }}"
                    onsubmit="return confirm('Queue a new {{ job.kind == 'scan' ? 'scan' : 'SHA-256 verification' }} job?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('retry_job_' ~ job.id) }}">
                    <button class="action-icon-button" type="submit"
                      title="Retry job #{{ job.id }} as a new job" aria-label="Retry job {{ job.id }}">{{ icon('restore') }}</button>
                  </form>
                {% endif %}
                {% if can_remove %}
                  <form method="post" action="{{ path('app_job_remove',{id:job.id}) }}"
                    onsubmit="return confirm('Remove job #{{ job.id }} and its event history? Stored scan results are retained. This cannot be undone.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('remove_job_' ~ job.id) }}">
                    <input type="hidden" name="confirm" value="DELETE">
                    <button class="action-icon-button is-destructive" type="submit"
                      title="Delete job #{{ job.id }} and its event log" aria-label="Delete job history {{ job.id }}">{{ icon('trash') }}</button>
                  </form>
                {% elseif is_finished and job.file_action_batch_id %}
                  <a class="action-icon-button" href="{{ path('app_action_detail',{id:job.file_action_batch_id}) }}"
                     title="File-action recovery history must be resolved before deleting this log"
                     aria-label="Review recovery history for job {{ job.id }}">{{ icon('details') }}</a>
                {% endif %}
              </div>
              {% if job.state == 'cancelling' %}
                <small class="muted job-cancel-hint" data-job-hint>
                  Cancellation requested — waiting for worker acknowledgement.
                  {% if overdue %}Job heartbeat overdue; open resolve action.{% endif %}
                </small>
              {% elseif job.state == 'running' and not scan_kind %}
                <small class="muted">File operation executing; review its action history.</small>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% include 'jobs/_pager.html.twig' %}
  {% endif %}
</section>
<section class="panel" data-worker-status data-api-url="{{ path('app_jobs_api') }}">
  {% set worker_state=worker.state|default('not_reporting') %}
  <div class="panel-heading worker-status-heading">
    <div><h2>Background worker</h2>
      <p class="muted">Live process and job activity, checked independently.</p></div>
    <span class="status" data-worker-field="state"
      role="status" aria-live="polite">{{ {
        'working':'Worker responding', 'ready':'Ready', 'stalled':'Job heartbeat overdue',
        'waiting':'Waiting for worker', 'not_reporting':'No recent worker activity'
      }[worker_state]|default('Unknown') }}</span>
  </div>
  <div class="panel-content">
    <div class="worker-status-grid">
      <div><span class="muted">Workers reporting</span>
        <strong data-worker-field="active">{{ worker.active|default(0)|number_format }}</strong>
        <small>Process heartbeat in the last 90 seconds</small></div>
      <div><span class="muted">Jobs with a recent heartbeat</span>
        <strong data-worker-field="jobs_responding">{{ worker.jobs_responding|default(0)|number_format }}</strong>
        <small>Worker check-in within 3 minutes; not proof that file bytes are advancing</small></div>
      <div><span class="muted">Queued / unfinished</span>
        <strong><span data-worker-field="queued_jobs">{{ worker.queued_jobs|default(0) }}</span>
          / <span data-worker-field="jobs_running">{{ worker.jobs_running|default(0) }}</span></strong>
        <small>Waiting and currently running jobs</small></div>
    </div>
    <div class="worker-diagnostics">
      <div>Last process heartbeat:
        <strong data-worker-field="last_heartbeat">{{ worker.last_heartbeat|default(null) ? worker.last_heartbeat ~ ' UTC' : 'None recorded' }}</strong></div>
      <div>Last active job update:
        <strong data-worker-field="last_job_heartbeat">{{ worker.last_job_heartbeat|default(null) ? worker.last_job_heartbeat ~ ' UTC' : 'None recorded' }}</strong></div>
      <small>Last checked: <span data-worker-last-checked>On page load</span></small>
    </div>
    <p class="worker-status-guidance" data-worker-guidance aria-live="polite">
      {% if worker_state == 'working' %}
        A job has reported a recent heartbeat. This confirms the worker is checking in,
        but does not by itself prove that file processing is advancing. Inspect its byte progress and latest event.
      {% elseif worker_state == 'ready' %}
        The CLI worker is responding and ready to process queued jobs.
      {% elseif worker_state == 'stalled' %}
        An unfinished job has not reported recently. Check its last progress before recovering it.
        The job may be processing a large file.
      {% elseif worker_state == 'waiting' %}
        Jobs are queued, but no worker heartbeat is currently available.
        Check that the background service is started.
      {% else %}
        No recent process or active-job heartbeat is available.
        If no jobs are queued, this can simply mean the worker is idle or scheduled.
      {% endif %}
    </p>
    <div class="worker-maintenance-actions">
      <button type="button" class="secondary" data-worker-refresh>Refresh status</button>
      <a class="secondary link-button" href="{{ path('app_system') }}">System health</a>
      <a class="secondary link-button" href="{{ path('app_jobs') }}">Reload job list</a>
    </div>
    <form method="post" class="worker-recover-form" data-worker-recovery
          action="{{ path('app_jobs_recover') }}"
          {% if worker.recovery_candidates|default(0) < 1 or worker.active|default(0) > 0 or worker.jobs_responding|default(0) > 0 %}hidden{% endif %}
          onsubmit="return confirm('Only recover if these jobs are no longer progressing. This marks stale jobs failed. Proceed?')">
      <input type="hidden" name="_token" value="{{ csrf_token('recover_stalled_jobs') }}">
      <input type="hidden" name="confirm" value="RECOVER">
      <button type="submit" class="secondary">Recover stale jobs (<span data-worker-field="recovery_candidates">{{ worker.recovery_candidates|default(0) }}</span>)</button>
      <small>Only jobs with no heartbeat for at least 10 minutes.
        This does not restart the worker or modify filesystem data.</small>
    </form>
    {% if is_dsm %}
      <p class="worker-note">On Synology, DSM Package Center manages the DUP service.
        Refresh checks the database now; it does not restart the package. If the worker is genuinely
        stopped, restart DUP from DSM Package Center. <strong>Do not restart an active scan</strong>
        merely because an older process heartbeat is displayed.</p>
    {% else %}
      <p class="worker-note">On Windows or Linux, use a service manager, Task Scheduler or cron
        to launch the PHP worker. Status refresh never starts a second worker.</p>
      <code class="worker-command">php bin/console dup:jobs:work --loop</code>
    {% endif %}
  </div>
</section>
<script type="module" src="{{ asset('assets/jobs.js') }}?v=0.7.15"></script>
{% endblock %}
