{% extends 'base.html.twig' %}
{% block title %}Jobs{% endblock %}
{% block section %}Jobs{% endblock %}
{% block body %}
<div class="page-heading"><div><div class="eyebrow">OPERATIONS</div><h1>Job monitor</h1>
  <p class="muted">Queued scans, duplicate recalculations, reversible file actions, current phases, heartbeat, cancellation and recovery. This page refreshes job statuses automatically.</p></div>
  <a class="secondary link-button" href="{{ path('app_profiles') }}">Manage profiles</a>
</div>
<section class="panel">
<div class="panel-heading"><h2>Background jobs</h2><span class="muted">{{ jobs|length }} recent</span></div>
{% if jobs is empty %}
  <div class="empty-state">No scan jobs have been queued yet. <a href="{{ path('app_profiles') }}">Choose a profile</a>.</div>
{% else %}
  <div class="table-wrap">
    <table id="jobs-table">
      <thead><tr><th>Job / profile</th><th>Stage</th><th>Status</th><th>Progress</th><th>Heartbeat</th><th>Details</th><th>Actions</th></tr></thead>
      <tbody>
      {% for job in jobs %}
        <tr data-job-id="{{ job.id }}">
          <td><strong>#{{ job.id }}</strong><div class="muted">{{ job.profile_name ?? 'Profile deleted' }}</div></td>
          <td data-field="phase">{{ job.phase|replace({'_':' '}) }}</td>
          <td><span class="status" data-field="state">{{ job.state }}</span></td>
          <td>
            <div data-field="progress-text" class="muted">{{ job.progress_current|number_format }}
              {% if job.progress_total is not null %}/ {{ job.progress_total|number_format }}{% endif %}</div>
            <progress max="{{ job.progress_total > 0 ? job.progress_total : 1 }}"
              value="{{ job.progress_current < (job.progress_total > 0 ? job.progress_total : 1) ? job.progress_current : (job.progress_total > 0 ? job.progress_total : 0) }}"
              data-field="progress-bar"></progress>
          </td>
          <td data-field="heartbeat" class="muted">{{ job.heartbeat_at ?? '—' }} UTC</td>
          <td><span data-field="error">{{ job.error_code ?? '—' }}</span>
            <div><a class="text-link" href="{{ path('app_job_events',{id:job.id}) }}" target="_blank" rel="noopener">Events</a></div></td>
          <td>{% if job.state in ['queued','running','cancelling'] %}
            <form method="post" action="{{ path('app_job_cancel',{id:job.id}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('cancel_job_' ~ job.id) }}">
              <button class="secondary" type="submit" {{ job.state == 'cancelling' ? 'disabled' : '' }}>Cancel</button>
            </form>
            {% else %}<span class="muted">—</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
</section>
<section class="panel">
  <div class="panel-heading"><h2>Background worker</h2>
    <span class="status">{{ worker.active > 0 ? 'Running' : 'Not responding' }}</span>
  </div>
  <div class="panel-content">
    <div class="worker-summary">
      <p>{{ worker.active|number_format }} active worker{{ worker.active == 1 ? '' : 's' }}</p>
      <span class="muted">Last heartbeat: {{ worker.last_heartbeat ? worker.last_heartbeat ~ ' UTC' : 'None recorded' }}</span>
    </div>
    {% if is_dsm %}
      <p class="worker-note">Synology DSM starts and manages this worker through the DUP package service. No manual command is needed.</p>
      {% if worker.active == 0 %}
        <div class="notice notice-warning">The background worker is not reporting. Check the DUP service in DSM Package Center and review System health before starting new scans.</div>
      {% endif %}
    {% else %}
      <p class="worker-note">On Windows or Linux, run the worker with your service manager, Task Scheduler or cron. The persistent job queue survives restarts.</p>
      <code class="worker-command">php bin/console dup:jobs:work --loop</code>
      <p class="worker-note">Recovery command for expired jobs:</p>
      <code class="worker-command">php bin/console dup:jobs:recover</code>
    {% endif %}
  </div>
</section>
<script type="module" src="{{ asset('assets/jobs.js') }}"></script>
{% endblock %}
