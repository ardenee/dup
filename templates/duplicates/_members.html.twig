 {% from 'duplicates/_format.html.twig' import bytes, hash %}
{% from 'duplicates/_actions.html.twig' import actions %}
{% for file in members %}
  <tr class="dup-child" data-dup-child>
    <td class="dup-num dup-child-num">{{ start_number + loop.index0 }}</td>
    <td class="dup-file-id">
      {% if is_granted('ROLE_ADMIN') and not historical|default(false) %}
      <label class="dup-select">
        <input type="checkbox" data-dup-select value="{{ file.file_entry_id }}"
          data-file-path="{{ file.full_path }}" aria-label="Select {{ file.relative_path }}">
        <span>{{ file.file_entry_id }}</span>
      </label>
      {% else %}<span>{{ file.file_entry_id }}</span>{% endif %}
    </td>
    <td class="dup-file-name" title="{{ file.full_path }}">
      <span class="dup-child-path">{{ file.relative_path }}</span>
    </td>
    <td class="dup-file-size" title="{{ file.size_bytes|number_format }} bytes">{{ bytes(file.size_bytes) }}</td>
    <td class="dup-file-date">{{ file.mtime_epoch|date('Y-m-d H:i','UTC') }}</td>
    <td class="dup-file-hash">{{ hash(file.hash_value) }}</td>
    <td class="dup-file-actions">
      {% if historical|default(false) %}
        <span class="muted">Historical</span>
      {% elseif file.error_code is null %}
        {{ actions(file.file_entry_id,group.rules_version == 1,group.file_count,false) }}
      {% else %}
        <span class="muted">{{ file.error_code }}</span>
      {% endif %}
    </td>
  </tr>
{% endfor %}
{% if previous or next %}
  <tr class="dup-members-pager" data-dup-child>
    <td colspan="7">
      <span>Files {{ start_number }}–{{ start_number + members|length - 1 }} of {{ group.file_count }} in this group</span>
      <nav aria-label="Group {{ group.id }} files">
        {% if previous %}
          <a href="{{ path('app_duplicate_group',{id:group.id,before:previous}) }}"
             data-dup-page data-ajax-url="{{ path('app_duplicate_members',{id:group.id,before:previous}) }}">Previous files</a>
        {% endif %}
        {% if next %}
          <a href="{{ path('app_duplicate_group',{id:group.id,after:next}) }}"
             data-dup-page data-ajax-url="{{ path('app_duplicate_members',{id:group.id,after:next}) }}">Next files</a>
        {% endif %}
      </nav>
    </td>
  </tr>
{% endif %}
