<div class="dup-member-heading">
  <div>
    <strong>Group #{{ group.id }} — {{ group.file_count|number_format }} files</strong>
    <span class="muted">Matching {{ group.rules_version == 1 ? 'SHA-256' : (group.rules_version == 2 ? 'CRC32 3 Part' : (group.rules_version == 3 ? 'CRC32 Full' : 'file size')) }}</span>
  </div>
  <a class="text-link" href="{{ path('app_duplicate_group',{id:group.id}) }}">Open full group view</a>
</div>
{% if members is empty %}
  <div class="empty-state">No file records remain in this group.</div>
{% else %}
  <div class="table-wrap dup-member-table">
    <table>
      <thead><tr>
        <th>File path</th><th>Size</th><th>Modified (UTC)</th><th>Hash</th><th>Actions</th>
      </tr></thead>
      <tbody>
        {% for file in members %}
        <tr>
          <td class="dup-member-path" title="{{ file.path }}/{{ file.filename }}"><code>{{ file.path }}{{ file.path ends with '/' or file.path ends with '\\' ? '' : '/' }}{{ file.filename }}</code></td>
          <td class="group-size">{{ file.size_bytes|number_format }} bytes</td>
          <td class="dup-member-date">{{ file.mtime_epoch|date('Y-m-d H:i:s','UTC') }}</td>
          <td class="dup-member-hash"><code>{{ file.hash_value ?? 'Not computed' }}</code></td>
          <td>
            <div class="dup-member-actions">
              {% if file.error_code is null %}
                <a class="text-link" href="{{ path('app_rename_file',{id:file.file_entry_id}) }}">Rename</a>
                {% if group.rules_version == 1 and group.file_count > 1 %}
                  <form method="post" action="{{ path('app_action_preview',{id:file.file_entry_id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('preview_file_' ~ file.file_entry_id) }}">
                    <button class="secondary" type="submit">Preview quarantine</button>
                  </form>
                {% endif %}
              {% else %}<span class="muted">{{ file.error_code }}</span>{% endif %}
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="result-toolbar dup-member-footer">
    <span class="muted">{{ members|length }} file records on this page (up to 100 per page)</span>
    <nav aria-label="Group #{{ group.id }} member pages">
      {% if previous %}
        <a data-dup-page href="{{ path('app_duplicate_group',{id:group.id,before:previous}) }}"
           data-ajax-url="{{ path('app_duplicate_members',{id:group.id,before:previous}) }}">Previous files</a>
      {% endif %}
      {% if next %}
        <a data-dup-page href="{{ path('app_duplicate_group',{id:group.id,after:next}) }}"
           data-ajax-url="{{ path('app_duplicate_members',{id:group.id,after:next}) }}">Next files</a>
      {% endif %}
    </nav>
  </div>
{% endif %}
