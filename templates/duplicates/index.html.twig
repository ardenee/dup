{% extends 'base.html.twig' %}
{% from 'duplicates/_format.html.twig' import bytes, hash, method %}
{% from 'duplicates/_actions.html.twig' import actions %}
{% block title %}Duplicates{% endblock %}
{% block section %}Duplicates{% endblock %}
{% block page_styles %}<link rel="stylesheet" href="{{ asset('assets/duplicates.css') }}?v=3">{% endblock %}
{% block body %}
{% include 'duplicates/_icons.html.twig' %}
<div class="page-heading dup-heading">
  <div>
    <div class="eyebrow">FIND & MANAGE DUPLICATES</div>
    <h1>Duplicate files</h1>
    <p class="muted">Choose a scan below. You can review older results here without leaving the Duplicates page.</p>
  </div>
  <div class="profile-page-actions">
    <a class="secondary link-button" href="{{ path('app_reports',selected_profile ? {profile:selected_profile} : {}) }}">Full scan history</a>
    {% if is_granted('ROLE_ADMIN') %}
      <a class="secondary link-button" href="{{ path('app_profiles') }}">Manage scan profiles</a>
    {% endif %}
  </div>
</div>

<section class="panel scan-picker-panel" aria-label="Choose duplicate scan">
  <form method="get" action="{{ path('app_duplicates') }}" class="scan-picker" data-scan-picker-form>
    {% if scan_before|default(null) %}
      <input type="hidden" name="scan_before" value="{{ scan_before }}">
    {% endif %}
    <div class="field">
      <label for="dup-profile">Profile</label>
      <select name="profile" id="dup-profile" data-scan-profile>
        <option value="" {{ selected_profile is null ? 'selected' : '' }}>All profiles — latest scans</option>
        {% for profile in profiles %}
          <option value="{{ profile.id }}" {{ selected_profile == profile.id ? 'selected' : '' }}>
            {{ profile.name }}{% if profile.run_id %} · {{ profile.duplicate_groups|number_format }} current groups{% else %} · no current scan{% endif %}
          </option>
        {% endfor %}
      </select>
      <small class="muted">Select a profile to display its saved scans.</small>
    </div>
    <div class="field">
      <label for="dup-run">Scan</label>
      <select name="run" id="dup-run" data-scan-run {{ selected_profile is null ? 'disabled' : '' }}>
        <option value="">Latest completed {{ selected_profile ? 'scan for this profile' : 'scans' }}</option>
        {% for scan in scan_choices|default([]) %}
          <option value="{{ scan.id }}" {{ selected_run|default(null) == scan.id ? 'selected' : '' }}>
            Scan #{{ scan.id }} · {{ (scan.finished_at ?? scan.started_at ?? '')|slice(0,16) }} UTC ·
            {{ scan.state == 'completed' and scan.id == latest_run_id|default(-1) ? 'Latest' : 'Historical' }} ·
            {{ scan.duplicate_groups|default(0)|number_format }} groups
          </option>
        {% endfor %}
      </select>
      <small class="muted">
        {% if selected_profile is null %}Select a profile to see its previous scans.
        {% elseif scan_choices is empty %}No saved scans for this profile.
        {% else %}Choose any retained scan to inspect its duplicates.
        {% endif %}
      </small>
    </div>
    <div class="scan-picker-actions">
      <button class="primary" type="submit">View results</button>
      {% if selected_profile is not null %}
        {% if scan_before|default(null) %}
          <a class="text-link" href="{{ path('app_duplicates',{profile:selected_profile}) }}">Newest scans</a>
        {% endif %}
        {% if scan_choices_more|default(false) and scan_choices_last|default(null) %}
          <a class="text-link" href="{{ path('app_duplicates',{profile:selected_profile,scan_before:scan_choices_last}) }}">Older scans</a>
        {% endif %}
        <a class="text-link" href="{{ path('app_reports',{profile:selected_profile}) }}">Scan details &amp; maintenance</a>
      {% endif %}
    </div>
  </form>
  {% if selected_run|default(null) %}
    <div class="scan-selection-summary {{ historical ? 'scan-selection-historical' : '' }}">
      <div>
        <strong>{{ historical ? 'Historical snapshot — read-only' : 'Current completed snapshot' }}</strong>
        <span>Scan #{{ selected_run }} · {{ run_info.profile_name }} ·
          {{ run_info.finished_at ?? 'Date unavailable' }} UTC ·
          {{ run_info.duplicate_groups|default(0)|number_format }} groups</span>
        {% if historical %}
          <small>These files may have moved or changed since this scan. File actions and downloads are disabled for past snapshots.</small>
        {% endif %}
      </div>
      <a href="{{ path('app_report_run',{id:selected_run}) }}" class="secondary link-button">Scan report</a>
    </div>
  {% elseif selected_profile %}
    <div class="scan-selection-summary">
      <div>
        <strong>Latest completed scan</strong>
        <span>Showing current results for the selected profile. Previous scans are available in the Scan selector above.</span>
      </div>
    </div>
  {% else %}
    <div class="scan-selection-summary">
      <div><strong>All current profiles</strong>
        <span>Showing the latest completed scan for each profile. Select a profile to browse older scans.</span></div>
    </div>
  {% endif %}
</section>

{% if selected_profile is not null and not historical|default(false) and is_granted('ROLE_ADMIN') and verification|default(null) and verification.can_verify %}
  <section class="panel dup-verification-bar">
    <div>
      <strong>Second-stage verification available</strong>
      <p class="muted">{{ verification.files|number_format }} candidate files in
        {{ verification.groups|number_format }} duplicate groups can be verified
        using full-file SHA-256. This reads only files already identified as
        duplicates, then updates the verified result groups. No full rescan.</p>
    </div>
    <form method="post" action="{{ path('app_duplicates_verify') }}"
      onsubmit="return confirm('Verify {{ verification.files }} candidate files with full SHA-256?')">
      <input type="hidden" name="_token" value="{{ csrf_token('verify_duplicate_candidates') }}">
      <input type="hidden" name="profile" value="{{ selected_profile }}">
      <input type="hidden" name="confirm" value="VERIFY">
      <button class="primary" type="submit">Verify duplicates (SHA-256)</button>
    </form>
  </section>
{% elseif selected_run is not null and run_info and run_info.verification_method|default(null) %}
  <div class="dup-verification-done">
    <strong>Second-stage verified:</strong> {{ run_info.verification_method|upper }}
    · {{ run_info.verified_at ?? 'Date unavailable' }} UTC
  </div>
{% endif %}

<section class="panel dup-browser" id="duplicate-groups"
  data-bulk-delete-url="{{ path('app_delete_preview') }}"
  data-bulk-delete-token="{{ csrf_token('delete_selected') }}"
  data-bulk-move-url="{{ path('app_move_preview') }}"
  data-bulk-move-token="{{ csrf_token('move_selected') }}"
  data-bulk-rename-url="{{ path('app_rename_selected') }}"
  data-bulk-rename-token="{{ csrf_token('rename_selected') }}"
  data-bulk-duplicate-url="{{ path('app_bulk_preview') }}"
  data-bulk-duplicate-token="{{ csrf_token('bulk_duplicate_action') }}"
  data-historical="{{ historical|default(false) ? '1' : '0' }}">
  <div class="dup-toolbar">
    <div class="dup-overview">
      <strong>{{ totals.total_groups|number_format }}</strong> groups
      <span class="dup-separator"></span>
      <strong>{{ totals.total_members|number_format }}</strong> matching files
      <span class="dup-separator"></span>
      <strong>{{ bytes(totals.reclaimable_bytes) }}</strong> potential savings
    </div>
    <div class="dup-controls">
      <button type="button" data-dup-expand-all>Expand all</button>
      <button type="button" data-dup-collapse-all>Collapse all</button>
      {% if is_granted('ROLE_ADMIN') and not historical|default(false) %}
      <div class="dup-selection-tools" aria-label="Choose files">
        <button type="button" data-dup-select-visible>Select visible</button>
        <button type="button" data-dup-invert>Invert</button>
        <button type="button" data-dup-clear-selection disabled>Clear selection</button>
        <button type="button" data-dup-copy disabled>Copy paths</button>
      </div>
      <div class="dup-bulk-actions" aria-label="Bulk file actions">
        <span class="dup-bulk-actions-label">Selected: <span data-dup-selected-count aria-live="polite">0</span></span>
        <button type="button" class="primary" data-dup-rename disabled>Rename</button>
        <button type="button" class="primary" data-dup-move disabled>Move</button>
        <button type="button" class="dup-delete-button" data-dup-delete disabled>Delete</button>
        <button type="button" data-dup-link disabled>Link</button>
      </div>
      {% endif %}
    </div>
  </div>
  {% if groups is not empty and is_granted('ROLE_ADMIN') and not historical|default(false) %}
    <div class="dup-how-to">
      <strong>1.</strong> Expand a group. <strong>2.</strong> Select individual files or use <strong>Select matches</strong>
      to leave the first copy untouched. <strong>3.</strong> Choose Rename, Move, Delete or Link above
      to preview the change before confirming. Delete is permanent, not a move or quarantine.
      Limit: 50 files per action, from one profile.
    </div>
  {% endif %}
  {% if groups is empty %}
    <div class="empty-state">No duplicate groups were indexed in this {{ selected_run|default(null) ? 'scan' : 'current scan selection' }}.</div>
  {% else %}
    {% include 'duplicates/_pager.html.twig' %}
    <p class="dup-scroll-hint">Scroll the table sideways to view hashes and file actions.
      {% if is_granted('ROLE_ADMIN') and not historical|default(false) %}
        Select files in expanded rows, or use Select matches. Bulk Rename, Move, Delete and Link are available for up to 50 files from one profile. Link requires full SHA-256 matching and an unselected survivor. Delete does not require a survivor and is permanent; the confirmation page lists every affected file.
      {% endif %}</p>
    <div class="table-wrap dup-file-table-wrap">
      <table class="dup-file-table">
        <colgroup>
          <col class="dup-col-num"><col class="dup-col-id"><col class="dup-col-file">
          <col class="dup-col-size"><col class="dup-col-date"><col class="dup-col-hash"><col class="dup-col-actions">
        </colgroup>
        <thead>
          <tr>
            <th>#</th><th>ID / Select</th><th>File (relative to profile folder)</th>
            <th>Size</th><th>Modified</th><th>Hash</th><th>Actions</th>
          </tr>
        </thead>
        {% for group in groups %}
          <tbody class="dup-set" id="dup-body-{{ group.id }}" data-dup-set data-group-id="{{ group.id }}" data-profile-id="{{ group.profile_id }}" data-file-count="{{ group.file_count }}">
            <tr class="dup-primary" data-dup-primary>
              <td class="dup-num">
                <button type="button" class="dup-disclosure" data-dup-toggle
                  data-members-url="{{ path('app_duplicate_members',{id:group.id}) }}"
                  aria-controls="dup-body-{{ group.id }}" aria-expanded="false"
                  aria-label="Expand {{ group.file_count - 1 }} matching files in group {{ group.id }}"></button>
                <span title="Group #{{ group.id }}">{{ page_start + loop.index0 }}</span>
              </td>
              <td class="dup-file-id">
                {% if group.first_file_id %}
                  {% if is_granted('ROLE_ADMIN') and not historical|default(false) %}
                  <label class="dup-select">
                    <input type="checkbox" data-dup-select value="{{ group.first_file_id }}"
                      data-file-path="{{ group.full_path }}" aria-label="Select {{ group.relative_path }}">
                    <span>{{ group.first_file_id }}</span>
                  </label>
                  {% else %}<span>{{ group.first_file_id }}</span>{% endif %}
                {% else %}<span class="muted">—</span>{% endif %}
              </td>
              <td class="dup-file-name">
                <button type="button" class="dup-filename" data-dup-toggle
                  data-members-url="{{ path('app_duplicate_members',{id:group.id}) }}"
                  aria-controls="dup-body-{{ group.id }}" aria-expanded="false"
                  title="{{ group.full_path }}">{{ group.relative_path }}</button>
                <small>
                  <span class="dup-match-count">{{ group.file_count - 1 }} {{ group.file_count == 2 ? 'match' : 'matches' }}</span>
                  <span class="dup-file-profile">{{ group.profile_name }}</span>
                </small>
              </td>
              <td class="dup-file-size" title="{{ group.size_bytes|number_format }} bytes">{{ bytes(group.size_bytes) }}</td>
              <td class="dup-file-date">{% if group.first_mtime_epoch is not null %}{{ group.first_mtime_epoch|date('Y-m-d H:i','UTC') }}{% else %}—{% endif %}</td>
              <td class="dup-file-hash">
                {{ hash(group.first_hash_value) }}
                <small title="{{ group.rules_version == 1 ? 'Full-file hash' : 'Candidate matching; not full-content verification' }}">{{ method(group.rules_version) }}</small>
              </td>
              <td class="dup-file-actions">
                {% if historical|default(false) %}
                  <span class="muted">Historical</span>
                {% elseif group.first_file_id and group.first_error_code is null %}
                  {{ actions(group.first_file_id,group.rules_version == 1,group.file_count,true) }}
                {% else %}
                  <span class="muted">{{ group.first_error_code ?? 'Unavailable' }}</span>
                {% endif %}
              </td>
            </tr>
            <tr class="dup-loading" data-dup-loading hidden>
              <td colspan="7">Loading matching files…</td>
            </tr>
          </tbody>
        {% endfor %}
        <tfoot>
          <tr>
            <td colspan="3"><strong>Shown:</strong> {{ groups|length|number_format }} groups · {{ page_rows|number_format }} file records</td>
            <td colspan="2"><strong>Listed data:</strong> {{ bytes(page_listed_bytes) }}</td>
            <td colspan="2"><strong>Possible cleanup:</strong> {{ bytes(page_reclaimable) }}</td>
          </tr>
          <tr>
            <td colspan="3">Total duplicate groups: <strong>{{ totals.total_groups|number_format }}</strong></td>
            <td colspan="2">Matching files: <strong>{{ totals.total_members|number_format }}</strong></td>
            <td colspan="2">Matched by profile's scan method</td>
          </tr>
        </tfoot>
      </table>
    </div>
    {% include 'duplicates/_pager.html.twig' %}
  {% endif %}
  <div class="dup-statusline">
    <span data-dup-message role="status" aria-live="polite">{{ historical|default(false) ? 'Read-only historical scan. Expand groups to inspect indexed files.' : 'Expand groups to inspect matches, then select files for Rename, Move, Delete or Link.' }}</span>
    <span>Size and CRC32 matches are candidates; file actions require additional verification.</span>
  </div>
</section>
<script type="module" src="{{ asset('assets/duplicates.js') }}?v=7"></script>
{% endblock %}
