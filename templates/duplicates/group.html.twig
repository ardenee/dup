{% extends 'base.html.twig' %}
{% from 'duplicates/_actions.html.twig' import actions %}
{% from '_table_headers.html.twig' import sort as sort_heading %}
{% from 'duplicates/_format.html.twig' import bytes %}
{% block title %}Duplicate group #{{ group.id }}{% endblock %}
{% block section %}Duplicates / Group #{{ group.id }}{% endblock %}
{% block page_styles %}<link rel="stylesheet" href="{{ asset('assets/duplicates.css') }}?v=5">{% endblock %}
{% block body %}
{% include 'duplicates/_icons.html.twig' %}
<div class="page-heading"><div><div class="eyebrow">DUPLICATE COMPARISON</div><h1>Group #{{ group.id }}</h1>
  <p class="muted">{{ group.profile_name }} · {{ group.file_count|number_format }} files · <span title="{{ group.size_bytes|number_format }} bytes">{{ bytes(group.size_bytes) }}</span> each</p>
  <p><span class="status">{{ group.rules_version == 1 ? 'Verified SHA-256' : (group.rules_version == 2 ? 'CRC32 3 Part — candidate' : (group.rules_version == 3 ? 'CRC32 Full — candidate' : 'Size only — candidate')) }}</span></p>
</div><a class="secondary link-button" href="{{ path('app_duplicates',historical|default(false) ? {run:group.run_id} : {profile:group.profile_id}) }}">Back to groups</a></div>
{% if historical|default(false) %}
  <div class="notice notice-warning"><strong>Historical scan #{{ group.run_id }} — read-only.</strong>
  File paths and match results are from the recorded scan; disk actions and downloads are unavailable.</div>
{% endif %}
<div class="stats-grid">
  <div class="stat"><span>Files</span><strong>{{ group.file_count|number_format }}</strong></div>
  <div class="stat"><span>Size per file</span><strong title="{{ group.size_bytes|number_format }} bytes">{{ bytes(group.size_bytes) }}</strong></div>
  <div class="stat"><span>Potential reclaimable</span><strong title="{{ group.reclaimable_bytes|number_format }} bytes">{{ bytes(group.reclaimable_bytes) }}</strong></div>
</div>
<section class="panel">
  <div class="panel-heading"><h2>File members</h2><span class="muted">{{ historical|default(false) ? 'Historical records only — no filesystem actions' : 'View, rename, move, link or permanently delete. Delete always requires confirmation.' }}</span></div>
  <form class="dup-table-filters" method="get" action="{{ path('app_duplicate_group',{id:group.id}) }}">
    <input type="hidden" name="sort" value="{{ sort|default('id') }}">
    <input type="hidden" name="dir" value="{{ dir|default('asc') }}">
    <div class="field"><label for="member-filename">File or folder contains</label>
      <input id="member-filename" name="name" maxlength="200" value="{{ name_filter|default('') }}" placeholder="File or folder"></div>
    <div class="field"><label for="member-status">File status</label>
      <select name="status" id="member-status">
        <option value="">All members</option>
        <option value="available" {{ status_filter|default('') == 'available' ? 'selected' : '' }}>Available</option>
        <option value="changed" {{ status_filter|default('') == 'changed' ? 'selected' : '' }}>Changed / unavailable</option>
      </select></div>
    <div class="dup-filter-buttons"><button type="submit" class="primary">Filter members</button>
      <a class="secondary link-button" href="{{ path('app_duplicate_group',{id:group.id}) }}">Clear</a></div>
  </form>
  {% if members is empty %}
    <div class="empty-state">No group members match this selection.</div>
  {% else %}
    <div class="table-wrap"><table><thead><tr>
      {{ sort_heading('app_duplicate_group',table_filters|default({id:group.id}),sort|default('id'),dir|default('asc'),'file','File path') }}
      {{ sort_heading('app_duplicate_group',table_filters|default({id:group.id}),sort|default('id'),dir|default('asc'),'size','Size') }}
      {{ sort_heading('app_duplicate_group',table_filters|default({id:group.id}),sort|default('id'),dir|default('asc'),'modified','Modified (UTC)') }}
      {{ sort_heading('app_duplicate_group',table_filters|default({id:group.id}),sort|default('id'),dir|default('asc'),'hash','Hash') }}
      <th>Actions</th></tr></thead>
    <tbody>{% for file in members %}
      <tr><td><code>{{ file.path }}{{ file.path ends with '/' or file.path ends with '\\' ? '' : '/' }}{{ file.filename }}</code></td>
      <td class="group-size" title="{{ file.size_bytes|number_format }} bytes">{{ bytes(file.size_bytes) }}</td>
      <td title="Unix timestamp: {{ file.mtime_epoch }}">{{ file.mtime_epoch is not null ? file.mtime_epoch|date('Y-m-d H:i','UTC') ~ ' UTC' : 'Unknown' }}</td>
      <td><code>{{ file.hash_value ?? 'Not computed' }}</code></td>
      <td>{% if historical|default(false) %}
        <span class="muted">Historical record</span>
      {% elseif file.error_code is null %}
        {{ actions(file.file_entry_id,group.rules_version == 1,group.file_count,false) }}
      {% else %}
        <span class="muted">Unavailable</span>
      {% endif %}</td></tr>
    {% endfor %}</tbody></table></div>
    <div class="result-toolbar"><span class="muted">{{ members|length }} of {{ total_members|default(group.file_count)|number_format }} matching group members</span>
      <nav aria-label="Group members pagination">
        {% if previous %}<a href="{{ path('app_duplicate_group',table_filters|default({id:group.id})|merge({before:previous})) }}">Previous</a>{% endif %}
        {% if next %}<a href="{{ path('app_duplicate_group',table_filters|default({id:group.id})|merge({after:next})) }}">Next</a>{% endif %}
      </nav>
    </div>
  {% endif %}
</section>
{% endblock %}
