{% extends 'base.html.twig' %}
{% block title %}Rename files{% endblock %}
{% block section %}Files / Rename{% endblock %}
{% block body %}
<div class="page-heading"><div>
  <div class="eyebrow">FILE MANAGEMENT</div>
  <h1>Rename files</h1>
  <p class="muted">Preview filename cleanup without rescanning. Select the files you want to rename; the background worker validates the files and never overwrites an existing name.</p>
</div><a class="secondary link-button" href="{{ path('app_search') }}">Search files</a></div>
<section class="panel">
  <div class="panel-heading"><h2>Cleanup rules</h2><span class="muted">Extensions are preserved</span></div>
  <form class="rename-options" method="get" action="{{ path('app_rename') }}">
    <div class="field"><label for="profile">Scan profile</label>
      <select name="profile" id="profile">
        {% for p in profiles %}<option value="{{ p.id }}" {{ profile == p.id ? 'selected' : '' }}>{{ p.name }}</option>{% endfor %}
      </select></div>
    <div class="field"><label for="filters">Remove text (comma-separated)</label>
      <input id="filters" name="filters" type="text" maxlength="1000" value="{{ filters }}" placeholder="e.g. [copy], sample"></div>
    <div class="field"><label for="dots">Dots in filename</label>
      <select id="dots" name="dots"><option value="0" {{ dots == 0 ? 'selected' : '' }}>Keep</option><option value="1" {{ dots == 1 ? 'selected' : '' }}>Change to spaces</option><option value="2" {{ dots == 2 ? 'selected' : '' }}>Change to underscores</option></select></div>
    <div class="field"><label for="unders">Underscores in filename</label>
      <select id="unders" name="unders"><option value="0" {{ unders == 0 ? 'selected' : '' }}>Keep</option><option value="1" {{ unders == 1 ? 'selected' : '' }}>Change to spaces</option><option value="2" {{ unders == 2 ? 'selected' : '' }}>Change to dots</option></select></div>
    <div class="rename-options-actions">
      <label class="search-check"><input type="checkbox" name="collapse" value="1" {{ collapse ? 'checked' : '' }}> Collapse repeated spaces</label>
      <label class="search-check"><input type="checkbox" name="dups" value="1" {{ dups ? 'checked' : '' }}> Duplicates only</label>
      <button type="submit" class="primary">Preview names</button>
    </div>
  </form>
</section>
<section class="panel">
  <div class="panel-heading"><h2>Rename candidates</h2><span class="muted">Up to 100 indexed files examined per page</span></div>
  {% if profiles is empty %}
    <div class="empty-state">No completed scans are available. <a href="{{ path('app_profiles') }}">Scan a profile</a> first.</div>
  {% elseif candidates.rows is empty %}
    <div class="empty-state">No filenames on this page require cleanup. Try different rules or the next page.</div>
    {% if candidates.next %}<div class="result-toolbar"><span class="muted">Continue looking</span><a href="{{ path('app_rename',paging|merge({after:candidates.next})) }}">Next page</a></div>{% endif %}
  {% else %}
  <form method="post" action="{{ path('app_rename_queue') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('queue_renames') }}">
    <input type="hidden" name="profile" value="{{ profile }}">
    <input type="hidden" name="filters" value="{{ filters }}">
    <input type="hidden" name="dots" value="{{ dots }}">
    <input type="hidden" name="unders" value="{{ unders }}">
    <input type="hidden" name="collapse" value="{{ collapse ? '1' : '0' }}">
    <div class="table-wrap"><table>
      <thead><tr><th><label><input type="checkbox" id="rename-select-all" aria-label="Select all shown"> Select</label></th><th>Folder</th><th>Current filename</th><th>Proposed filename</th><th>Size</th><th>Manual</th></tr></thead>
      <tbody>{% for file in candidates.rows %}
        <tr>
          <td><input type="checkbox" name="files[]" value="{{ file.id }}" class="rename-selection" aria-label="Select {{ file.filename }}"></td>
          <td><code>{{ file.directory }}</code></td>
          <td><code>{{ file.filename }}</code></td>
          <td><strong>{{ file.new_name }}</strong></td>
          <td class="group-size">{{ file.size_bytes|number_format }}</td>
          <td><a class="text-link" href="{{ path('app_rename_file',{id:file.id}) }}">Edit</a></td>
        </tr>
      {% endfor %}</tbody>
    </table></div>
    <div class="result-toolbar">
      <div class="rename-batch-actions"><button type="submit" class="primary" id="rename-queue" disabled>Queue selected renames</button><span class="muted" id="rename-selected-count">0 selected</span></div>
      {% if candidates.next %}<a href="{{ path('app_rename',paging|merge({after:candidates.next})) }}">Next page</a>{% endif %}
    </div>
  </form>
  {% endif %}
</section>
<section class="panel">
  <div class="panel-heading"><h2>Recent rename operations</h2><span class="muted">Recorded in the file-action audit history</span></div>
  {% if batches is empty %}<div class="empty-state">No renaming jobs have been queued.</div>
  {% else %}<div class="table-wrap"><table><thead><tr><th>Batch</th><th>Profile</th><th>Status</th><th>Renamed</th><th>Failed</th><th>Created (UTC)</th></tr></thead>
    <tbody>{% for batch in batches %}
      <tr><td>#{{ batch.id }}</td><td>{{ batch.profile_name }}</td><td><span class="status">{{ batch.state }}</span></td><td>{{ batch.renamed }}</td><td>{{ batch.failed }}</td><td>{{ batch.requested_at }}</td></tr>
    {% endfor %}</tbody></table></div>{% endif %}
</section>
<script type="module" src="{{ asset('assets/rename.js') }}"></script>
{% endblock %}
