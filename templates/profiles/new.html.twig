{% extends 'base.html.twig' %}
{% set editing = profile is not null %}
{% block title %}{{ editing ? 'Edit profile' : 'New profile' }}{% endblock %}
{% block section %}Profiles / {{ editing ? 'Edit' : 'New' }}{% endblock %}
{% block body %}
<div class="page-heading"><div><div class="eyebrow">SCANNING</div>
  <h1>{{ editing ? 'Edit scan profile' : 'New scan profile' }}</h1>
  <p class="muted">Select accessible server folders, file types and a hashing strategy. Only files with identical sizes are hashed.</p>
  {% if editing %}<p class="muted">Changes apply to future scans. Completed scan history remains intact.</p>{% endif %}
</div><a class="secondary link-button" href="{{ path('app_profiles') }}">Back to profiles</a></div>
<section class="panel form-panel">
  {% if errors %}<div class="notice notice-error" role="alert"><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>{% endif %}
  <form method="post" action="{{ editing ? path('app_profile_edit',{id:profile.id}) : path('app_profile_new') }}" data-folder-browser-endpoint="{{ path('app_folder_browse') }}">
    <input type="hidden" name="_token" value="{{ csrf_token(editing ? 'edit_profile_' ~ profile.id : 'create_profile') }}">
    <div class="field"><label for="name">Profile name</label>
      <input id="name" name="name" maxlength="140" required value="{{ app.request.request.get('name',editing ? profile.name : '') }}" placeholder="e.g. Music library"></div>
    <div class="field"><label for="source">Main folder</label>
      <input id="source" data-directory-input name="source_root" required value="{{ app.request.request.get('source_root',editing ? profile.source_root : '') }}" placeholder="D:\\Media or /srv/media">
      <small class="muted">Folders must be readable to the PHP and background worker accounts.</small></div>
    <div class="field"><label for="move">Move folder</label>
      <input id="move" data-directory-input name="move_root" required value="{{ app.request.request.get('move_root',editing ? profile.move_root : '') }}" placeholder="D:\\Archive or /srv/archive"></div>
    <div class="field"><label for="type">File-type preset</label>
      <select name="profile_type_id" id="type">{% for item in types %}
        <option value="{{ item.id }}" {{ app.request.request.get('profile_type_id',editing ? profile.profile_type_id : '') == item.id ? 'selected' : '' }}>{{ item.name }}</option>
      {% endfor %}</select></div>
    {% set selectedMode = app.request.request.get('hash_mode',editing ? profile.hash_mode : 'crc32_3part') %}
    <div class="field"><label for="mode">Duplicate matching</label>
      <select id="mode" name="hash_mode">
        <option value="size" {{ selectedMode == 'size' ? 'selected' : '' }}>File Size — fastest; candidates only</option>
        <option value="crc32_3part" {{ selectedMode == 'crc32_3part' ? 'selected' : '' }}>CRC32 3 Part — fast, original DUP default</option>
        <option value="crc32_full" {{ selectedMode == 'crc32_full' ? 'selected' : '' }}>CRC32 Full — reads the whole file</option>
        <option value="sha256" {{ selectedMode == 'sha256' ? 'selected' : '' }}>SHA-256 — full verified comparison</option>
      </select>
      <small class="muted">CRC32 3 Part reads 150 KiB from the beginning, middle and end of large files. Files under 450 KiB use full CRC32. Size and CRC32 matches are candidates; file actions must independently verify their contents.</small></div>
    <div class="field">
      <label for="file-exists-policy">File exists — Move and Rename destinations</label>
      {% set existingPolicy = app.request.request.get('file_exists_policy',editing ? profile.file_exists_policy : 'fail') %}
      <select name="file_exists_policy" id="file-exists-policy">
        <option value="fail" {{ existingPolicy == 'fail' ? 'selected' : '' }}>Fail — do not replace existing files</option>
        <option value="number" {{ existingPolicy == 'number' ? 'selected' : '' }}>Append Number — filename (1).ext, filename (2).ext</option>
        <option value="overwrite" {{ existingPolicy == 'overwrite' ? 'selected' : '' }}>Overwrite — replace the approved destination permanently</option>
      </select>
      <small class="muted">Applies to this scan profile only. Move and Rename use this preference for their new file operations. Existing approved jobs are unchanged.</small>
    </div>
    <div class="field"><label for="minimum">Minimum file size (bytes)</label>
      <input id="minimum" name="minimum_bytes" type="number" min="0" step="1" value="{{ app.request.request.get('minimum_bytes',editing ? profile.minimum_bytes : '0') }}" required></div>
    {% set scheduleMinutes = schedule.interval_minutes|default(0) + 0 %}
    {% set scheduledDefault = scheduleMinutes == 0 ? 'off' : (scheduleMinutes == 60 ? 'hourly' : (scheduleMinutes == 360 ? '6hours' : (scheduleMinutes == 720 ? '12hours' : (scheduleMinutes == 1440 ? 'daily' : (scheduleMinutes == 10080 ? 'weekly' : 'custom'))))) %}
    {% set scheduleChoice = app.request.request.get('schedule_choice',scheduledDefault) %}
    {% set customUnit = scheduleMinutes >= 10080 and scheduleMinutes % 10080 == 0 ? 'weeks' : (scheduleMinutes >= 1440 and scheduleMinutes % 1440 == 0 ? 'days' : (scheduleMinutes >= 60 and scheduleMinutes % 60 == 0 ? 'hours' : 'minutes')) %}
    {% set customMultiplier = customUnit == 'weeks' ? 10080 : (customUnit == 'days' ? 1440 : (customUnit == 'hours' ? 60 : 1)) %}
    {% set customAmount = scheduleMinutes > 0 ? (scheduleMinutes / customMultiplier)|round(0,'floor') : 1 %}
    <fieldset class="profile-schedule-fields">
      <legend>Automatic scans</legend>
      <div class="field">
        <label for="schedule-choice">Repeat schedule</label>
        <select id="schedule-choice" name="schedule_choice" data-profile-schedule-choice>
          {% for value,label in {'off':'Off','hourly':'Hourly','6hours':'Every 6 hours','12hours':'Every 12 hours','daily':'Daily','weekly':'Weekly','custom':'Custom interval and start time'} %}
            <option value="{{ value }}" {{ scheduleChoice == value ? 'selected' : '' }}>{{ label }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="profile-schedule-custom" data-profile-schedule-custom {{ scheduleChoice != 'custom' ? 'hidden' : '' }}>
        <div class="profile-custom-interval">
          <div class="field">
            <label for="schedule-amount">Repeat every</label>
            <input type="number" min="1" max="525600" id="schedule-amount" name="schedule_amount"
              value="{{ app.request.request.get('schedule_amount',customAmount) }}" data-custom-schedule-required>
          </div>
          <div class="field">
            <label for="schedule-unit">Units</label>
            {% set selectedUnit = app.request.request.get('schedule_unit',customUnit) %}
            <select name="schedule_unit" id="schedule-unit">
              {% for value,label in {'minutes':'Minutes','hours':'Hours','days':'Days','weeks':'Weeks'} %}
                <option value="{{ value }}" {{ selectedUnit == value ? 'selected' : '' }}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
        <div class="field">
          <label for="schedule-first-utc">First run (UTC)</label>
          <input type="datetime-local" id="schedule-first-utc" name="schedule_first_utc"
            value="{{ app.request.request.get('schedule_first_utc',(schedule.next_run_at|default('')|replace({' ':'T'}))|slice(0,16)) }}"
            data-custom-schedule-required>
          <small class="muted">Set the next scan's starting date and time in UTC. Later scans repeat from this time without drifting if the worker starts late. UTC does not shift for daylight saving time.</small>
        </div>
      </div>
      {% if schedule.next_run_at|default(null) %}
        <p class="muted">Currently scheduled next: <strong>{{ schedule.next_run_at }} UTC</strong></p>
      {% endif %}
    </fieldset>
    <div class="form-actions"><button class="primary" type="submit">{{ editing ? 'Save changes' : 'Save profile' }}</button>
      <a class="secondary link-button" href="{{ path('app_profiles') }}">Cancel</a></div>
  </form>
</section>
<script type="module" src="{{ asset('assets/folder-picker.js') }}"></script>
<script type="module" src="{{ asset('assets/profile-schedule.js') }}?v=1"></script>
{% endblock %}
