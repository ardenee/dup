{% extends 'base.html.twig' %}
{% from '_action_icons.html.twig' import icon %}
{% block title %}Scan profiles{% endblock %}
{% block section %}Profiles{% endblock %}
{% block body %}
<div class="page-heading">
  <div>
    <div class="eyebrow">SCAN & MANAGE</div>
    <h1>Scan profiles</h1>
    <p class="muted">Manage folders, schedules and duplicate scans from one place.</p>
  </div>
  <div class="profile-page-actions">
    <a class="secondary link-button" href="{{ path('app_jobs') }}">Job Monitor</a>
    <a class="primary link-button" href="{{ path('app_profile_new') }}">Add profile</a>
  </div>
</div>

{% if unresponsive_count|default(0) > 0 %}
<div class="notice notice-warning profile-stale-notice" role="status">
  <strong>{{ unresponsive_count }} profile{{ unresponsive_count != 1 ? 's' : '' }} with an unresponsive job.</strong>
  A scan or verification has not reported a heartbeat in over ten minutes.
  The saved results are still available; review the job and worker diagnostics before resolving it.
  <a href="{{ path('app_jobs') }}">Open Job Monitor</a>
  · <a href="{{ path('app_worker_log',{job:0}) }}">Worker startup diagnostics</a>
</div>
{% endif %}

<section class="panel profiles-overview">
  <div class="panel-heading">
    <div>
      <h2>Configured profiles</h2>
      <p class="muted">{{ profiles|length }} total
        {% if busy_count|default(0) > 0 %} · {{ busy_count }} active or queued{% endif %}
      </p>
    </div>
    <a class="text-link" href="{{ path('app_profile_types') }}">File-type presets ({{ types|length }})</a>
  </div>
  {% if profiles is empty %}
    <div class="empty-state">No profiles configured.
      <a href="{{ path('app_profile_new') }}">Create the first profile</a>.
    </div>
  {% else %}
    <div class="table-wrap profiles-overview-wrap">
      <table class="profiles-overview-table" data-local-table="profiles">
        <colgroup>
          <col class="profile-col-name">
          <col class="profile-col-settings">
          <col class="profile-col-results">
          <col class="profile-col-schedule">
          <col class="profile-col-state">
          <col class="profile-col-actions">
        </colgroup>
        <thead><tr>
          <th scope="col">Profile / source</th>
          <th scope="col">Scan settings</th>
          <th scope="col" data-sort-type="number">Completed scans / results</th>
          <th scope="col">Schedule</th>
          <th scope="col">State</th>
          <th scope="col">Actions</th>
        </tr></thead>
        <tbody>
          {% for profile in profiles %}
          <tr>
            <td>
              <a class="profile-name-link" href="{{ path('app_duplicates',{profile:profile.id}) }}"
                title="Browse current and older duplicate results for {{ profile.name }}">{{ profile.name }}</a>
              <div class="profile-path" title="{{ profile.source_root }}">{{ profile.source_root }}</div>
            </td>
            <td>
              <strong class="profile-setting-main">{{ profile.type_name }}</strong>
              <div class="profile-meta">{{ profile.hash_mode == 'sha256' ? 'SHA-256 verified' :
                  (profile.hash_mode == 'crc32_3part' ? 'CRC32 3 Part (fast)' :
                  (profile.hash_mode == 'crc32_full' ? 'CRC32 Full' : 'Size candidates only')) }}</div>
              <div class="profile-meta">File exists:
                {{ (profile.file_exists_policy|default('fail'))|replace({
                  'fail':'Fail','number':'Append Number','overwrite':'Overwrite'}) }}</div>
            </td>
            <td class="group-size" data-sort-value="{{ profile.completed_scans|default(0) }}">
              {% if profile.finished_at %}
                <a class="profile-result-link" href="{{ path('app_duplicates',{profile:profile.id}) }}">
                  {{ profile.duplicate_groups|number_format }} groups
                </a>
                <div class="profile-meta">{{ profile.files_indexed|number_format }} files indexed</div>
                <div class="profile-meta">{{ profile.completed_scans|default(0)|number_format }} retained scans</div>
                <div class="profile-date" title="{{ profile.finished_at }} UTC">{{ profile.finished_at }} UTC</div>
              {% elseif profile.retained_runs|default(0) > 0 %}
                <a class="profile-result-link" href="{{ path('app_duplicates',{profile:profile.id}) }}">Historical results available</a>
                <div class="profile-meta">{{ profile.retained_runs|number_format }} retained scans</div>
                <div class="profile-date">Last finished {{ profile.last_saved_at }} UTC</div>
              {% else %}
                <span class="muted">Never scanned</span>
                <div class="profile-meta">0 retained scans</div>
              {% endif %}
            </td>
            <td>
              <form method="post" action="{{ path('app_profile_schedule',{id:profile.id}) }}"
                class="schedule-inline-form profile-schedule-compact">
                <input type="hidden" name="_token" value="{{ csrf_token('schedule_profile_' ~ profile.id) }}">
                <label class="sr-only" for="profile-schedule-{{ profile.id }}">Automatic scan interval for {{ profile.name }}</label>
                <select id="profile-schedule-{{ profile.id }}" name="interval_minutes"
                  aria-label="Automatic scan interval for {{ profile.name }}">
                  {% for minutes,description in {0:'Off',60:'Hourly',360:'Every 6 hours',720:'Every 12 hours',1440:'Daily',10080:'Weekly'} %}
                    <option value="{{ minutes }}" {{ (profile.schedule_interval|default(0)) == minutes ? 'selected' : '' }}>{{ description }}</option>
                  {% endfor %}
                </select>
                <button class="action-icon-button" type="submit" title="Save automatic scan schedule"
                  aria-label="Save schedule for {{ profile.name }}">{{ icon('save') }}</button>
              </form>
              {% if profile.schedule_next %}
                <div class="profile-meta" title="Next scheduled scan">Next: {{ profile.schedule_next }} UTC</div>
              {% endif %}
              {% if profile.schedule_error %}
                <div class="profile-schedule-error" title="{{ profile.schedule_error }}">Schedule error: {{ profile.schedule_error }}</div>
              {% endif %}
            </td>
            <td>
              {% if profile.job_overdue|default(false) %}
                <a class="profile-status-link profile-status-stale"
                   href="{{ profile.active_job_id|default(null) ? path('app_job_detail',{id:profile.active_job_id}) : path('app_jobs') }}"
                   title="Heartbeat overdue; open job details and inspect worker diagnostics">
                  Unresponsive
                </a>
                <div class="profile-meta">{{ profile.active_kind|default('Job')|replace({'_':' ','-':' '}) }}</div>
                <div class="profile-meta">Last heartbeat {{ profile.active_heartbeat|default('Unknown') }} UTC</div>
              {% elseif profile.active_state %}
                <span class="status">{{ profile.active_state }}</span>
                <div class="profile-meta">{{ profile.active_phase|default('')|replace({'_':' '}) }}</div>
                {% if profile.active_job_id|default(null) %}
                  <a class="profile-mini-link" href="{{ path('app_job_detail',{id:profile.active_job_id}) }}">Job #{{ profile.active_job_id }}</a>
                {% endif %}
              {% else %}
                <span class="status">{{ profile.enabled ? 'Idle' : 'Disabled' }}</span>
              {% endif %}
            </td>
            <td class="profile-actions-cell">
              <div class="action-icon-group profile-action-toolbar"
                role="group" aria-label="Actions for {{ profile.name }}">
                <a class="action-icon-button" href="{{ path('app_duplicates',{profile:profile.id}) }}"
                  title="Browse scans and duplicates" aria-label="Browse scans for {{ profile.name }}">{{ icon('eye') }}</a>
                {% if profile.job_overdue|default(false) and profile.active_job_id|default(null) %}
                  <form method="post" action="{{ path('app_job_resolve',{id:profile.active_job_id}) }}"
                    onsubmit="return confirm('Confirm that the old worker process is stopped. Resolve stalled job #{{ profile.active_job_id }} and release this profile? The action does not terminate an OS process.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('resolve_stale_job_' ~ profile.active_job_id) }}">
                    <input type="hidden" name="confirm" value="RESOLVE">
                    <button class="action-icon-button is-destructive" type="submit"
                      title="Resolve unresponsive job #{{ profile.active_job_id }} after confirming its worker stopped"
                      aria-label="Resolve stalled job for {{ profile.name }}">{{ icon('restore') }}</button>
                  </form>
                {% else %}
                  <form method="post" action="{{ path('app_profile_scan',{id:profile.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('scan_profile_' ~ profile.id) }}">
                    <button class="action-icon-button" type="submit" {{ not profile.enabled or profile.active_state ? 'disabled' : '' }}
                      title="{{ profile.active_state ? 'A job is already active; open Job Monitor to manage it' : 'Start scan' }}"
                      aria-label="Start scan for {{ profile.name }}">{{ icon('scan') }}</button>
                  </form>
                {% endif %}
                <a class="action-icon-button" href="{{ path('app_reports',{profile:profile.id}) }}"
                  title="Reports and scan history" aria-label="Reports for {{ profile.name }}">{{ icon('history') }}</a>
                <a class="action-icon-button" href="{{ path('app_ignore_folders',{profile:profile.id}) }}"
                  title="Ignored folders" aria-label="Ignored folders for {{ profile.name }}">{{ icon('folder') }}</a>
                <a class="action-icon-button" href="{{ path('app_profile_edit',{id:profile.id}) }}"
                  title="Edit profile and File Exists settings" aria-label="Edit {{ profile.name }}">{{ icon('edit') }}</a>
                <form method="post" action="{{ path('app_profile_enabled',{id:profile.id}) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('toggle_profile_' ~ profile.id) }}">
                  <button class="action-icon-button {{ profile.enabled ? 'is-destructive' : '' }}" type="submit"
                    {{ profile.active_state ? 'disabled' : '' }}
                    title="{{ profile.enabled ? 'Disable profile' : 'Enable profile' }}"
                    aria-label="{{ profile.enabled ? 'Disable' : 'Enable' }} {{ profile.name }}">{{ icon('power') }}</button>
                </form>
              </div>
              {% if profile.job_overdue|default(false) and profile.active_job_id|default(null) %}
                <a class="profile-action-help" href="{{ path('app_worker_log',{job:profile.active_job_id}) }}">
                  Diagnose stuck job #{{ profile.active_job_id }}
                </a>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</section>

<details class="panel profile-preset-details">
  <summary class="panel-heading">
    <h2>File-type presets</h2>
    <span class="muted">Show current presets</span>
  </summary>
  <div class="table-wrap">
    <table data-local-table="file type presets">
      <thead><tr><th scope="col">Name</th><th scope="col">Extensions</th></tr></thead>
      <tbody>
        {% for preset in types %}
          <tr><td>{{ preset.name }}</td>
            <td><code>{{ preset.extensions is empty ? 'All file types' : preset.extensions }}</code></td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="result-toolbar">
    <a href="{{ path('app_profile_types') }}">Manage presets ({{ types|length }})</a>
  </div>
</details>
{% endblock %}
