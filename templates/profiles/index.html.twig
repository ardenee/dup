{% extends 'base.html.twig' %}
{% from '_action_icons.html.twig' import icon %}
{% block title %}Profiles{% endblock %}
{% block section %}Profiles{% endblock %}
{% block body %}
<div class="page-heading"><div><div class="eyebrow">SCANNING</div><h1>Profiles</h1>
  <p class="muted">Define source folders, file types, and scan settings. Scans run through a separate PHP CLI worker.</p></div>
  <div class="profile-page-actions">
    <a class="secondary link-button" href="{{ path('app_jobs') }}">Scan jobs</a>
    <a class="primary link-button" href="{{ path('app_profile_new') }}">Add profile</a>
  </div></div>
<section class="panel">
  <div class="panel-heading"><h2>Configured profiles</h2><span class="muted">{{ profiles|length }} total</span></div>
  {% if profiles is empty %}
    <div class="empty-state">No profiles configured. <a href="{{ path('app_profile_new') }}">Create the first profile</a>.</div>
  {% else %}
    <div class="table-wrap"><table data-local-table="profiles"><thead>
      <tr><th>Name / source</th><th>File type</th><th>Matching</th><th data-sort-type="number">Completed scans</th><th>Latest result</th><th>File exists</th><th>Schedule</th><th>State</th><th>Actions</th></tr>
    </thead><tbody>
    {% for profile in profiles %}
      <tr>
        <td><strong><a href="{{ path('app_duplicates',{profile:profile.id}) }}" title="Browse current and historical scans for this profile">{{ profile.name }}</a></strong><div class="muted"><code>{{ profile.source_root }}</code></div></td>
        <td>{{ profile.type_name }}</td>
        <td>{{ profile.hash_mode == 'sha256' ? 'Verified SHA-256' : (profile.hash_mode == 'crc32_3part' ? 'CRC32 3 Part (fast)' : (profile.hash_mode == 'crc32_full' ? 'CRC32 Full' : 'Size candidates only')) }}</td>
        <td class="group-size" data-sort-value="{{ profile.completed_scans|default(0) }}"><strong>{{ profile.completed_scans|default(0)|number_format }}</strong>
          <div class="muted">retained successful snapshots</div>
        </td>
        <td>{% if profile.finished_at %}
          <strong>{{ profile.duplicate_groups|number_format }} groups</strong>
          <div class="muted">{{ profile.files_indexed|number_format }} indexed · {{ profile.finished_at }}</div>
          {% elseif profile.retained_runs|default(0) > 0 %}
            <strong>Historical results available</strong>
            <div class="muted">{{ profile.retained_runs|number_format }} retained scans · last finished {{ profile.last_saved_at }} UTC</div>
          {% else %}<span class="muted">Never scanned</span>{% endif %}</td>
        <td><span class="status">{{ (profile.file_exists_policy|default('fail'))|replace({'fail':'Fail','number':'Append Number','overwrite':'Overwrite'}) }}</span></td>
        <td>
          <form method="post" action="{{ path('app_profile_schedule',{id:profile.id}) }}" class="schedule-inline-form">
            <input type="hidden" name="_token" value="{{ csrf_token('schedule_profile_' ~ profile.id) }}">
            <label for="profile-schedule-{{ profile.id }}" class="muted">Automatically scan</label>
            <select id="profile-schedule-{{ profile.id }}" name="interval_minutes">
              {% for minutes,description in {0:'Off',60:'Hourly',360:'Every 6 hours',720:'Every 12 hours',1440:'Daily',10080:'Weekly'} %}
                <option value="{{ minutes }}" {{ (profile.schedule_interval|default(0)) == minutes ? 'selected' : '' }}>{{ description }}</option>
              {% endfor %}
            </select>
            <button class="action-icon-button" type="submit" title="Save automatic scan schedule"
              aria-label="Save schedule for {{ profile.name }}">{{ icon('save') }}</button>
          </form>
          {% if profile.schedule_next %}<small class="muted">Next: {{ profile.schedule_next }} UTC</small>{% endif %}
          {% if profile.schedule_error %}<div class="report-error">Last schedule attempt failed: {{ profile.schedule_error }}</div>{% endif %}
        </td>
        <td>{% if profile.active_state %}<span class="status">{{ profile.active_state }}</span>
          <div class="muted">{{ profile.active_phase }}</div>
          {% else %}<span class="status">{{ profile.enabled ? 'Idle' : 'Disabled' }}</span>{% endif %}</td>
        <td><div class="action-icon-group" role="group" aria-label="Actions for {{ profile.name }}">
          <a class="action-icon-button" href="{{ path('app_duplicates',{profile:profile.id}) }}"
             title="Browse scans and duplicates" aria-label="Browse scans for {{ profile.name }}">{{ icon('eye') }}</a>
          <form method="post" action="{{ path('app_profile_scan',{id:profile.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('scan_profile_' ~ profile.id) }}">
            <button class="action-icon-button" type="submit" {{ not profile.enabled or profile.active_state ? 'disabled' : '' }}
              title="Start scan" aria-label="Start scan for {{ profile.name }}">{{ icon('scan') }}</button>
          </form>
          <a class="action-icon-button" href="{{ path('app_reports',{profile:profile.id}) }}"
             title="Reports and scan history" aria-label="Reports for {{ profile.name }}">{{ icon('history') }}</a>
          <a class="action-icon-button" href="{{ path('app_ignore_folders',{profile:profile.id}) }}"
             title="Ignored folders" aria-label="Ignored folders for {{ profile.name }}">{{ icon('folder') }}</a>
          <a class="action-icon-button" href="{{ path('app_profile_edit',{id:profile.id}) }}"
             title="Edit profile and File Exists settings" aria-label="Edit {{ profile.name }}">{{ icon('edit') }}</a>
          <form method="post" action="{{ path('app_profile_enabled',{id:profile.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('toggle_profile_' ~ profile.id) }}">
            <button class="action-icon-button {{ profile.enabled ? 'is-destructive' : '' }}" type="submit"
              {{ profile.active_state ? 'disabled' : '' }}
              title="{{ profile.enabled ? 'Disable profile' : 'Enable profile' }}"
              aria-label="{{ profile.enabled ? 'Disable' : 'Enable' }} {{ profile.name }}">{{ icon('power') }}</button>
          </form>
          </div></td>
      </tr>
    {% endfor %}
    </tbody></table></div>
  {% endif %}
</section>
<section class="panel">
  <div class="panel-heading"><h2>File-type presets</h2><a class="secondary link-button" href="{{ path('app_profile_types') }}">Manage presets ({{ types|length }})</a></div>
  <div class="table-wrap"><table data-local-table="file type presets"><thead><tr><th>Name</th><th>Extensions</th></tr></thead><tbody>
    {% for preset in types %}<tr><td>{{ preset.name }}</td>
      <td><code>{{ preset.extensions is empty ? 'All file types' : preset.extensions }}</code></td></tr>{% endfor %}
  </tbody></table></div>
</section>
{% endblock %}
