{% extends 'base.html.twig' %}
{% block title %}Old scan cleanup{% endblock %}
{% block section %}Reports / Scan maintenance{% endblock %}
{% block body %}
<div class="page-heading">
  <div><div class="eyebrow">SCAN HISTORY MAINTENANCE</div><h1>Clean up old scans</h1>
    <p class="muted">Remove old database snapshots that are no longer current,
      without changing or deleting files on disk.</p></div>
  <a class="secondary link-button" href="{{ path('app_reports') }}">Scan history</a>
</div>
<section class="panel panel-content">
  <h2>Choose what to retain</h2>
  <form method="get" action="{{ path('app_reports_cleanup') }}" class="job-cleanup-form">
    <div class="field"><label for="scan-prune-profile">Scan profile</label>
      <select id="scan-prune-profile" name="profile">
        <option value="">All profiles</option>
        {% for p in profiles %}
          <option value="{{ p.id }}" {{ profile == p.id ? 'selected' : '' }}>{{ p.name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="field"><label for="scan-prune-days">Older than</label>
      <select id="scan-prune-days" name="days">
        {% for value,label in {30:'30 days',90:'90 days',180:'180 days',365:'1 year'} %}
          <option value="{{ value }}" {{ value == days ? 'selected' : '' }}>{{ label }}</option>
        {% endfor %}
      </select>
    </div>
    <button type="submit" class="secondary">Preview eligible scans</button>
  </form>
  <p><strong>{{ eligible|number_format }}</strong> old scans currently qualify for database cleanup.</p>
  <p>Only historical completed, failed or cancelled runs are eligible.
    The latest completed scan for each profile is always retained.
    Scans used by active jobs or file-action/recovery records are protected.</p>
  <p class="muted">Cleanup removes stored indexed files, directories and duplicate groups
    from the database. The original filesystem is never touched.
    Job history is retained, while the scan reference is detached. At most 50 runs
    are removed per confirmation to avoid long web requests.</p>
  {% if eligible > 0 %}
    <form method="post" action="{{ path('app_reports_cleanup') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('prune_scans') }}">
      <input type="hidden" name="days" value="{{ days }}">
      <input type="hidden" name="profile" value="{{ profile ?? '' }}">
      <div class="field"><label for="scan-prune-confirm">Type PRUNE SCANS to confirm</label>
        <input id="scan-prune-confirm" name="confirm" required pattern="PRUNE SCANS" autocomplete="off"></div>
      <button type="submit" class="secondary">Remove eligible old scans</button>
    </form>
  {% endif %}
</section>
<section class="panel panel-content">
  <h2>Remove an individual scan</h2>
  <p>To inspect a particular scan's files, groups, error records and blockers before
    deleting it, use Review / remove from the scan-history table.</p>
  <a class="secondary link-button" href="{{ path('app_reports') }}">Open scan history</a>
</section>
{% endblock %}
