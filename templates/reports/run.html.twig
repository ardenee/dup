{% extends 'base.html.twig' %}
{% from '_table_headers.html.twig' import sort as sort_heading %}
{% block title %}Scan #{{ run.id }}{% endblock %}
{% block section %}Reports / Scan #{{ run.id }}{% endblock %}
{% block body %}
<div class="page-heading"><div>
  <div class="eyebrow">HISTORICAL SCAN REPORT</div>
  <h1>Run #{{ run.id }}</h1>
  <p class="muted">{{ run.profile_name }} · <span class="status">{{ run.state }}</span> · {{ run.started_at ?? 'Not started' }} UTC</p>
</div><div class="profile-page-actions">
  <a class="secondary link-button" href="{{ path('app_duplicates',{run:run.id}) }}">Browse this scan's duplicates</a>
  <a class="secondary link-button" href="{{ path('app_reports',{profile:run.profile_id}) }}">Back to reports</a>
</div></div>

{% if run.state not in ['completed','archived'] %}
  <div class="notice notice-warning"><strong>Incomplete scan:</strong> these figures may be partial. DUP only includes current completed runs in storage summaries.</div>
{% elseif run.state == 'archived' %}
  <div class="notice"><strong>Historical completed scan:</strong> an older run preserved for reporting only. Its results are not considered current.</div>
{% endif %}

{% if cleanup %}
<section class="panel panel-content">
  <h2>{{ cleanup.is_current ? 'Clear current scan results' : 'Remove historical scan' }}</h2>
  <p class="muted">This operation removes only DUP database scan records. It never deletes or changes files on disk. The profile and completed job event history are retained.</p>
  <p><strong>Database cleanup:</strong> {{ cleanup.files|number_format }} indexed files,
    {{ cleanup.directories|number_format }} directories,
    {{ cleanup.groups|number_format }} duplicate groups for run #{{ run.id }}.
    {{ cleanup.jobs|number_format }} job records will be retained.</p>
  {% if cleanup.is_current %}
    <div class="notice notice-warning"><strong>Current scan:</strong> clearing removes these live results from search, duplicates and reports. Older completed scans become read-only archived history, not replacement current results. A new scan is required to populate the profile again.</div>
  {% else %}
    <p>Only this historical run's results will be removed. The profile's latest completed snapshot is unaffected.</p>
  {% endif %}
  {% if not cleanup.can_remove %}
    <div class="notice notice-warning"><strong>Removal blocked:</strong> {{ cleanup.blocked_reason }}</div>
  {% else %}
    {% set approval = cleanup.is_current ? 'CLEAR' : 'DELETE' %}
    <form method="post" action="{{ path('app_report_remove',{id:run.id}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('remove_scan_' ~ run.id) }}">
      <div class="field">
        <label for="scan-remove-confirm">Type {{ approval }} to confirm removal of scan #{{ run.id }}</label>
        <input type="text" id="scan-remove-confirm" name="confirm" autocomplete="off" pattern="{{ approval }}" required>
      </div>
      <button type="submit" class="secondary">{{ cleanup.is_current ? 'Clear current scan results' : 'Remove historical scan' }}</button>
    </form>
  {% endif %}
</section>
{% endif %}

<div class="stats-grid">
  <div class="stat"><span>Files encountered</span><strong>{{ run.files_seen|number_format }}</strong></div>
  <div class="stat"><span>Files indexed</span><strong>{{ run.files_indexed|number_format }}</strong></div>
  <div class="stat"><span>Indexed bytes</span><strong>{{ run.bytes_indexed|number_format }}</strong></div>
  <div class="stat"><span>Directories excluded from matching (files)</span><strong>{{ run.files.ignored_files|number_format }}</strong></div>
  <div class="stat"><span>Content hashes stored</span><strong>{{ run.files.hashed_files|number_format }}</strong></div>
  <div class="stat"><span>Symbolic links indexed (not followed)</span><strong>{{ run.files.symlinks_indexed|number_format }}</strong></div>
  <div class="stat"><span>Current quarantined file records</span><strong>{{ run.files.quarantined_files|number_format }}</strong></div>
</div>

<section class="panel">
  <div class="panel-heading"><h2>Duplicate classification</h2></div>
  <dl class="details">
    <div><dt>Total duplicate groups</dt><dd>{{ run.groups.groups|number_format }}</dd></div>
    <div><dt>Verified SHA-256 groups</dt><dd>{{ run.groups.verified_groups|number_format }}</dd></div>
    <div><dt>Potential recoverable bytes — verified</dt><dd>{{ run.groups.verified_bytes|number_format }} bytes</dd></div>
    <div><dt>Candidate groups (size or CRC32) — not verified</dt><dd>{{ run.groups.candidate_groups|number_format }}</dd></div>
    <div><dt>Potential bytes — unverified candidates</dt><dd>{{ run.groups.candidate_bytes|number_format }} bytes</dd></div>
    <div><dt>Run-level errors reported</dt><dd>{{ run.error_count|number_format }}</dd></div>
    <div><dt>File records with non-quarantine states</dt><dd>{{ run.files.flagged_files|number_format }}</dd></div>
    <div><dt>Worker result</dt><dd>{{ run.job_state ?? 'Not started' }} {% if run.job_error %}· {{ run.job_error }}{% endif %}</dd></div>
    <div><dt>Finished</dt><dd>{{ run.finished_at ?? 'Not finished' }} UTC</dd></div>
  </dl>
  <div class="report-explanation">Verified recoverable bytes represent the potential space from keeping one copy per duplicate group—not space already reclaimed. Size and CRC32 matches are candidates, not full-content verification. SHA-256 groups are eligible for further safety checks before file actions. Changes to ignore rules or reversible file actions may update groups within the latest completed run; indexed file history is retained.</div>
</section>

<section class="panel">
  <div class="panel-heading"><div><h2>Download scan data</h2><p class="muted">CSV exports stream records; no filesystem rescan is performed.</p></div></div>
  <div class="report-downloads">
    <a class="secondary link-button" href="{{ path('app_report_csv',{id:run.id,kind:'files'}) }}">All indexed files CSV</a>
    <a class="secondary link-button" href="{{ path('app_report_csv',{id:run.id,kind:'duplicates'}) }}">Duplicate memberships CSV</a>
    <a class="secondary link-button" href="{{ path('app_report_csv',{id:run.id,kind:'states'}) }}">File states CSV</a>
    <a class="secondary link-button" href="{{ path('app_report_csv',{id:run.id,kind:'events'}) }}">Job event log CSV</a>
  </div>
  <p class="muted report-explanation">The files export includes ignored-folder entries; the duplicate export contains only currently matched group members. Failure details from a scan that aborts before indexing are recorded in the job event log, not as per-file status rows.</p>
</section>

<section class="panel">
  <div class="panel-heading"><div><h2>File status records</h2><p class="muted">Quarantined files, failed file actions and any other indexed file states — up to 50 per page.</p></div></div>
  <form method="get" action="{{ path('app_report_run',{id:run.id}) }}" class="table-event-filter">
    <label for="file-status-filter">File status</label>
    <select name="status" id="file-status-filter">
      <option value="">All flagged states</option>
      {% for state in file_states|default([]) %}
        <option value="{{ state }}" {{ file_status|default('') == state ? 'selected' : '' }}>{{ state|replace({'_':' '}) }}</option>
      {% endfor %}
    </select>
    <input type="hidden" name="sort" value="{{ file_sort|default('id') }}">
    <input type="hidden" name="dir" value="{{ file_dir|default('asc') }}">
    <button class="secondary" type="submit">Filter files</button>
    <a class="secondary link-button" href="{{ path('app_report_run',{id:run.id}) }}">Clear</a>
  </form>
  {% if flagged is empty %}
    <div class="empty-state">No flagged files match your filters. For scan-level errors, inspect the events below.</div>
  {% else %}
    <div class="table-wrap"><table>
      <thead><tr>
        {{ sort_heading('app_report_run',file_filters|default({id:run.id}),file_sort|default('id'),file_dir|default('asc'),'file','File') }}
        {{ sort_heading('app_report_run',file_filters|default({id:run.id}),file_sort|default('id'),file_dir|default('asc'),'status','Status') }}
        {{ sort_heading('app_report_run',file_filters|default({id:run.id}),file_sort|default('id'),file_dir|default('asc'),'size','Size') }}
        {{ sort_heading('app_report_run',file_filters|default({id:run.id}),file_sort|default('id'),file_dir|default('asc'),'ignored','Ignored folder') }}
      </tr></thead>
      <tbody>{% for file in flagged %}
      <tr><td><code>{{ file.directory }}{{ file.directory ends with '/' or file.directory ends with '\\' ? '' : '/' }}{{ file.filename }}</code></td>
      <td><span class="status">{{ file.error_code }}</span></td>
      <td class="group-size">{{ file.size_bytes|number_format }} bytes</td>
      <td>{{ file.is_ignored ? 'Yes' : 'No' }}</td></tr>
      {% endfor %}</tbody></table></div>
    <div class="result-toolbar"><span class="muted">{{ flagged|length }} of {{ flagged_total|default(flagged|length)|number_format }} flagged files shown</span>
      <nav aria-label="File states pagination">
        {% if previous|default(null) %}<a href="{{ path('app_report_run',file_filters|default({id:run.id})|merge({before:previous})) }}">Previous page</a>{% endif %}
        {% if next %}<a href="{{ path('app_report_run',file_filters|default({id:run.id})|merge({after:next})) }}">Next page</a>{% endif %}
      </nav>
    </div>
  {% endif %}
</section>

<section class="panel">
  <div class="panel-heading"><div><h2>Warning and error events</h2><p class="muted">Most recent 40 events for this run and its jobs. Export all events above.</p></div></div>
  {% if warnings is empty %}
    <div class="empty-state">No warning or error events recorded for this run.</div>
  {% else %}
    <div class="table-wrap"><table data-local-table="recent warning events"><thead><tr><th>When (UTC)</th><th>Job</th><th>Severity</th><th>Code / detail</th></tr></thead>
    <tbody>{% for event in warnings %}<tr>
      <td>{{ event.created_at }}</td><td>#{{ event.job_id }}</td>
      <td><span class="status">{{ event.severity }}</span></td>
      <td><strong>{{ event.code }}</strong><div><code>{{ event.context }}</code></div></td>
    </tr>{% endfor %}</tbody></table></div>
  {% endif %}
</section>
{% endblock %}
