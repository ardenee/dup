{% extends 'base.html.twig' %}
{% from '_action_icons.html.twig' import icon %}
{% from 'duplicates/_format.html.twig' import bytes %}
{% from '_table_headers.html.twig' import sort as sort_heading %}
{% block title %}Reports{% endblock %}
{% block section %}Reports{% endblock %}
{% block body %}
<div class="page-heading"><div>
  <div class="eyebrow">STORAGE & SCAN ANALYTICS</div>
  <h1>Reports</h1>
  <p class="muted">Current results use only each profile's latest completed scan. Previous scans remain available below. Overlapping profile roots may count the same files more than once.</p>
</div>{% if is_granted('ROLE_ADMIN') %}
  <div class="profile-page-actions">
    <a class="secondary link-button" href="{{ path('app_reports_cleanup') }}">Clean old scans</a>
    <a class="secondary link-button" href="{{ path('app_system') }}">System health</a>
  </div>{% endif %}</div>

<section class="panel">
  <div class="panel-heading"><h2>Profile filter</h2></div>
  <form method="get" action="{{ path('app_reports') }}" class="report-filter">
    <label for="profile">View reports for</label>
    <select id="profile" name="profile">
      <option value="">All profiles</option>
      {% for profile in profiles %}
        <option value="{{ profile.id }}" {{ selected_profile == profile.id ? 'selected' : '' }}>{{ profile.name }}</option>
      {% endfor %}
    </select>
    <label for="scan-state">Scan status</label>
    <select name="state" id="scan-state">
      <option value="">All statuses</option>
      {% for value in ['queued','running','completed','archived','failed','cancelled'] %}
        <option value="{{ value }}" {{ history_state|default('') == value ? 'selected' : '' }}>{{ value|capitalize }}</option>
      {% endfor %}
    </select>
    <input type="hidden" name="sort" value="{{ history_sort|default('id') }}">
    <input type="hidden" name="dir" value="{{ history_dir|default('desc') }}">
    <button type="submit" class="secondary">Filter scans</button>
    <a class="secondary link-button" href="{{ path('app_reports') }}">Clear</a>
  </form>
</section>

<div class="stats-grid">
  <div class="stat"><span>Profiles with completed scans</span><strong>{{ totals.completed_profiles|number_format }} / {{ totals.profiles|number_format }}</strong></div>
  <div class="stat"><span>Indexed files</span><strong>{{ totals.files_indexed|number_format }}</strong></div>
  <div class="stat"><span>Indexed bytes</span><strong title="{{ totals.bytes_indexed|number_format }} bytes">{{ bytes(totals.bytes_indexed) }}</strong></div>
  <div class="stat"><span>Verified duplicate groups</span><strong>{{ totals.verified_groups|number_format }}</strong></div>
  <div class="stat"><span>Potential verified recovery</span><strong title="{{ totals.verified_bytes|number_format }} bytes">{{ bytes(totals.verified_bytes) }}</strong></div>
  <div class="stat"><span>Unverified size candidates</span><strong>{{ totals.candidate_groups|number_format }}</strong><small title="{{ totals.candidate_bytes|number_format }} bytes">{{ bytes(totals.candidate_bytes) }} candidates — not confirmed savings</small></div>
</div>

<section class="panel">
  <div class="panel-heading"><div><h2>Current profile snapshots</h2>
    <p class="muted">Possible recovery is not disk space already freed. Each group retains one copy. Totals are per profile and are not de-duplicated across overlapping roots.</p></div>
  </div>
  {% if snapshots is empty %}
    <div class="empty-state">No profiles match this filter.
      {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_profiles') }}">Create a profile</a>.{% endif %}
    </div>
  {% else %}
    <div class="table-wrap"><table data-local-table="profile snapshots">
      <thead><tr><th>Profile</th><th>Latest completed</th><th data-sort-type="number">Files indexed</th><th data-sort-type="number">Duplicate groups</th><th data-sort-type="number">Verified potential savings</th><th data-sort-type="number">Unverified candidates</th></tr></thead>
      <tbody>{% for profile in snapshots %}
        <tr><td><strong><a href="{{ path('app_duplicates',{profile:profile.profile_id}) }}">{{ profile.profile_name }}</a></strong></td>
          {% if profile.run_id is null %}
            <td colspan="5" class="muted">No completed scan yet</td>
          {% else %}
            <td><a href="{{ path('app_report_run',{id:profile.run_id}) }}">Run #{{ profile.run_id }}</a>
              <div class="muted">{{ profile.finished_at }} UTC</div></td>
            <td class="group-size">{{ profile.files_indexed|number_format }}</td>
            <td class="group-size">{{ profile.duplicate_groups|number_format }}</td>
            <td class="group-size" data-sort-value="{{ profile.verified_bytes }}"><span title="{{ profile.verified_bytes|number_format }} bytes">{{ bytes(profile.verified_bytes) }}</span>
              <div class="muted">{{ profile.verified_groups|number_format }} verified groups</div></td>
            <td class="group-size" data-sort-value="{{ profile.candidate_bytes }}"><span title="{{ profile.candidate_bytes|number_format }} bytes">{{ bytes(profile.candidate_bytes) }}</span>
              <div class="muted">{{ profile.candidate_groups|number_format }} unverified groups</div></td>
          {% endif %}
        </tr>
      {% endfor %}</tbody></table></div>
  {% endif %}
</section>

<section class="panel">
  <div class="panel-heading"><div><h2>Scan history</h2>
    <p class="muted">25 runs per page. Filter by profile or scan status; click a column heading to sort every matching scan.</p></div>
    <span class="muted">{{ history_total|default(history|length)|number_format }} matching scans · {{ history|length }} on this page</span>
  </div>
  {% if history is empty %}
    <div class="empty-state">No scan history for this selection.</div>
  {% else %}
    <div class="table-wrap"><table>
      <thead><tr>
        {{ sort_heading('app_reports',history_filters|default({}),history_sort|default('id'),history_dir|default('desc'),'id','Run / profile') }}
        {{ sort_heading('app_reports',history_filters|default({}),history_sort|default('id'),history_dir|default('desc'),'state','State') }}
        {{ sort_heading('app_reports',history_filters|default({}),history_sort|default('id'),history_dir|default('desc'),'files','Indexed files') }}
        {{ sort_heading('app_reports',history_filters|default({}),history_sort|default('id'),history_dir|default('desc'),'groups','Duplicate groups') }}
        {{ sort_heading('app_reports',history_filters|default({}),history_sort|default('id'),history_dir|default('desc'),'started','Started') }}
        {{ sort_heading('app_reports',history_filters|default({}),history_sort|default('id'),history_dir|default('desc'),'finished','Finished / error') }}
        <th>Actions</th></tr></thead>
      <tbody>{% for run in history %}
        <tr>
          <td><a href="{{ path('app_report_run',{id:run.id}) }}"><strong>#{{ run.id }}</strong></a>
            <div class="muted">{{ run.profile_name }}</div>
            {# Duplicate results are opened with the icon in Actions. #}</td>
          <td><span class="status">{{ run.state }}</span></td>
          <td class="group-size">{{ run.files_indexed|number_format }}</td>
          <td class="group-size">{{ run.duplicate_groups|number_format }}</td>
          <td>{{ run.started_at ?? 'Not started' }}</td>
          <td>{{ run.finished_at ?? '—' }}
            {% if run.job_error %}<div class="report-error">{{ run.job_error }}</div>{% endif %}
          </td>
          <td><div class="action-icon-group">
            {% if run.state in ['completed','archived'] %}
            <a class="action-icon-button" href="{{ path('app_duplicates',{run:run.id}) }}"
               title="Browse scan duplicate results" aria-label="Duplicates for scan {{ run.id }}">{{ icon('eye') }}</a>
            {% endif %}
            <a class="action-icon-button" href="{{ path('app_report_run',{id:run.id}) }}"
               title="{{ is_granted('ROLE_ADMIN') ? 'Review report and manage scan' : 'View scan report' }}"
               aria-label="{{ is_granted('ROLE_ADMIN') ? 'Manage' : 'View report for' }} scan {{ run.id }}">{{ icon('report') }}</a>
          </div></td>
        </tr>
      {% endfor %}</tbody></table></div>
    <div class="result-toolbar">
      <span class="muted">Navigating by scan ID avoids slow large offsets.</span>
      <nav aria-label="Scan history pagination">
        {% if previous %}<a href="{{ path('app_reports',history_filters|default({})|merge({after:previous})) }}">Previous page</a>{% endif %}
        {% if next %}<a href="{{ path('app_reports',history_filters|default({})|merge({before:next})) }}">Next page</a>{% endif %}
      </nav>
    </div>
  {% endif %}
</section>

<section class="panel panel-content">
  <h2>Recent operational status</h2>
  <p class="muted">Jobs created in the past 24 hours: {{ recent_failures.failed_jobs|number_format }} failed;
    {{ recent_failures.queued_jobs|number_format }} queued;
    {{ recent_failures.running_jobs|number_format }} running.</p>
  <p>{% if is_granted('ROLE_ADMIN') %}
    For live progress and failure details, use the <a href="{{ path('app_jobs') }}">Job Monitor</a>.
    {% endif %}
    To download files, duplicate memberships or recorded file states as CSV, open a scan run.</p>
</section>
{% endblock %}
