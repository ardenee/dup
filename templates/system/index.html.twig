{% extends 'base.html.twig' %}
{% block title %}System health{% endblock %}
{% block section %}Settings / System health{% endblock %}
{% block body %}
<div class="page-heading">
  <div><div class="eyebrow">DEPLOYMENT & DIAGNOSTICS</div><h1>System health</h1>
    <p class="muted">Installed versions, runtime requirements, scan queue and recovery warnings.
      Live job metrics refresh automatically every 15 seconds.</p></div>
  <a class="secondary link-button" href="{{ path('app_jobs') }}">Review jobs and errors</a>
</div>
<div data-system-endpoint="{{ path('app_system_status') }}">
  <section class="panel">
    <div class="panel-heading"><div><h2>Runtime and installation</h2>
      <p class="muted">Identify the running PHP environment and database schema when troubleshooting.</p></div>
      <span class="status" data-system-status>{{ health.status|replace({'_':' '}) }}</span>
    </div>
    <dl class="details">
      <div><dt>Host environment</dt><dd>{{ health.checks.host_os }}
        {% if health.checks.dsm_version %} · DSM {{ health.checks.dsm_version }}{% endif %}</dd></div>
      <div><dt>Operating system / kernel</dt><dd>{{ health.checks.os_version }}</dd></div>
      <div><dt>PHP version / interface</dt><dd>{{ health.checks.php }} · {{ health.checks.php_sapi }}</dd></div>
      <div><dt>PHP configuration file</dt><dd>{{ health.checks.php_ini }}</dd></div>
      <div><dt>PHP memory limit</dt><dd>{{ health.checks.php_memory_limit }}</dd></div>
      <div><dt>Database name</dt><dd data-system-field="database_name">{{ health.checks.database_name }}</dd></div>
      <div><dt>Database engine / server version</dt><dd>{{ health.checks.database_engine }}
        · <span data-system-field="database_server_version">{{ health.checks.database_server_version }}</span></dd></div>
      <div><dt>Installed schema migration</dt><dd data-system-field="schema_version">{{ health.checks.schema_version }}</dd></div>
      <div><dt>Latest application migration</dt><dd>{{ health.checks.schema_latest_available }}</dd></div>
      <div><dt>Schema migrations still needed</dt>
        <dd><span data-system-field="schema_pending">{{ health.checks.schema_pending is null ? 'Unavailable' : health.checks.schema_pending }}</span>
          {% if health.checks.schema_pending > 0 %}
            <span class="health-bad">Upgrade required</span>
          {% elseif health.checks.schema_pending is not null %}
            <span class="health-good">Up to date</span>
          {% endif %}</dd></div>
    </dl>
    {% if health.checks.schema_pending > 0 %}
      <div class="notice notice-warning health-notice">
        Database migrations are pending. Apply the application migrations before using the new features.
        Schema changes should run through the application's deployment/update process, not from this screen.
      </div>
    {% endif %}
  </section>

  <section class="panel">
    <div class="panel-heading"><div><h2>Required PHP extensions</h2>
      <p class="muted">Green: loaded by PHP. Red: missing from this runtime or PHP profile.</p></div>
      <span class="{{ health.checks.required_extensions is empty ? 'health-good' : 'health-bad' }}">
        {{ health.checks.required_extensions is empty ? 'All required extensions loaded' : health.checks.required_extensions|length ~ ' missing' }}
      </span>
    </div>
    <div class="health-extensions">
      {% for extension in health.checks.php_extensions %}
        <div class="health-extension {{ extension.loaded ? 'extension-loaded' : 'extension-missing' }}">
          <strong>{{ extension.name }}</strong>
          <span>{{ extension.loaded ? 'Loaded' : 'Missing — enable this extension' }}</span>
          {% if extension.version %}<small>v{{ extension.version }}</small>{% endif %}
        </div>
      {% endfor %}
    </div>
    {% if health.checks.required_extensions is not empty %}
      <div class="panel-content">
        <p><strong>Required action:</strong> enable
        {{ health.checks.required_extensions|join(', ') }} in the PHP environment used by DUP.
        On Synology, check the PHP profile assigned in Web Station; the command-line worker must also have these extensions.</p>
      </div>
    {% endif %}
  </section>

  <div class="stats-grid">
    <a class="stat stat-link" href="{{ path('app_jobs',{state:'queued'}) }}"><span>Queued jobs</span>
      <strong data-system-field="queued_jobs">{{ health.checks.queued_jobs }}</strong><small>Inspect waiting scans and actions</small></a>
    <a class="stat stat-link" href="{{ path('app_jobs',{state:'running'}) }}"><span>Running / cancelling jobs</span>
      <strong data-system-field="running_jobs">{{ health.checks.running_jobs }}</strong><small>Open live job details</small></a>
    <a class="stat stat-link" href="{{ path('app_jobs') }}"><span>Stalled jobs</span>
      <strong data-system-field="stalled_jobs">{{ health.checks.stalled_jobs }}</strong><small>Review stale heartbeat and errors</small></a>
    <a class="stat stat-link" href="{{ path('app_jobs',{state:'failed'}) }}"><span>Failed jobs (24 hours)</span>
      <strong data-system-field="failed_jobs_24h">{{ health.checks.failed_jobs_24h }}</strong><small>View failed job history</small></a>
    <a class="stat stat-link" href="{{ path('app_actions',{state:'needs_review'}) }}"><span>File actions needing review</span>
      <strong data-system-field="needs_review_actions">{{ health.checks.needs_review_actions }}</strong><small>Inspect recovery paths</small></a>
    <a class="stat stat-link" href="{{ path('app_profiles') }}"><span>Scheduled scan profiles</span>
      <strong data-system-field="scheduled_profiles">{{ health.checks.scheduled_profiles }}</strong><small>Manage automatic scan intervals</small></a>
    <a class="stat stat-link" href="{{ path('app_profiles') }}"><span>Schedules with errors</span>
      <strong data-system-field="schedules_with_errors">{{ health.checks.schedules_with_errors }}</strong><small>Review permission and scan-source failures</small></a>
    <a class="stat stat-link" href="{{ path('app_profiles') }}"><span>Overdue schedules</span>
      <strong data-system-field="overdue_schedules">{{ health.checks.overdue_schedules }}</strong><small>Check worker or active profile jobs</small></a>
  </div>

  {% if health.checks.needs_review_actions > 0 %}
    <div class="notice notice-warning"><strong>Attention required:</strong>
      some file operations need manual review. Before another action, inspect
      <a href="{{ path('app_actions',{state:'needs_review'}) }}">their recorded original and recovery paths</a>.
    </div>
  {% endif %}

  <section class="panel">
    <div class="panel-heading"><h2>Background worker</h2>
      <a class="text-link" href="{{ path('app_jobs') }}">Job monitor</a></div>
    <dl class="details">
      <div><dt>Worker state</dt><dd data-system-field="worker">{{ health.checks.worker|replace({'_':' '}) }}</dd></div>
      <div><dt>Workers reporting</dt><dd data-system-field="worker_processes">{{ health.checks.worker_processes }}</dd></div>
      <div><dt>Active jobs reporting</dt><dd data-system-field="worker_active_jobs">{{ health.checks.worker_active_jobs }}</dd></div>
      <div><dt>Last process heartbeat (UTC)</dt><dd data-system-field="worker_last_heartbeat">{{ health.checks.worker_last_heartbeat ?? 'Never' }}</dd></div>
      <div><dt>Last active job heartbeat (UTC)</dt><dd data-system-field="worker_last_job_heartbeat">{{ health.checks.worker_last_job_heartbeat ?? 'Never' }}</dd></div>
      <div><dt>Oldest queued job (UTC)</dt><dd data-system-field="oldest_queued_at">{{ health.checks.oldest_queued_at ?? 'None' }}</dd></div>
    </dl>
    <div class="panel-content">
      <p>The same CLI worker handles scans and automatic scan schedules on Windows,
        Linux and DSM. An active worker is required for scheduled scans; Web Station
        alone does not run them.</p>
      <code>php bin/console dup:jobs:work --loop --idle-sleep=5 --max-jobs=1 --env=prod</code>
    </div>
  </section>
</div>

<section class="panel">
  <div class="panel-heading"><h2>Recent failed jobs</h2>
    <a class="text-link" href="{{ path('app_jobs',{state:'failed'}) }}">All failures</a></div>
  {% if health.checks.recent_failures is empty %}
    <div class="empty-state">No failed jobs have been recorded.</div>
  {% else %}
    <div class="table-wrap"><table data-local-table="recent failures">
      <thead><tr><th>Job</th><th>Type</th><th>Error code</th><th>Finished (UTC)</th></tr></thead>
      <tbody>{% for job in health.checks.recent_failures %}
        <tr><td><a href="{{ path('app_job_detail',{id:job.id}) }}">#{{ job.id }} · View events</a></td>
          <td>{{ job.kind }}</td><td class="report-error">{{ job.error_code ?? 'Unknown' }}</td>
          <td>{{ job.finished_at ?? 'Not finished' }}</td>
        </tr>
      {% endfor %}</tbody>
    </table></div>
  {% endif %}
</section>
<p class="muted">The public <code>/health</code> endpoint reports readiness only.
  Detailed information here and at <code>/api/system/status</code> requires administrator access.</p>
<script type="module" src="{{ asset('assets/system.js') }}"></script>
{% endblock %}
