{% extends 'base.html.twig' %}
{% block title %}File action #{{ batch.id }}{% endblock %}
{% block section %}File actions / #{{ batch.id }}{% endblock %}
{% block body %}
{% set is_link = batch.action_kind == 'link' %}
{% set approval = is_link ? 'LINK' : 'QUARANTINE' %}
<div class="page-heading">
 <div><div class="eyebrow">CONFIRMATION & AUDIT</div><h1>{{ is_link ? 'Link duplicate' : 'Quarantine duplicate' }} #{{ batch.id }}</h1>
 <p class="muted">{{ batch.profile_name }} · <span class="status">{{ batch.state|replace({'_':' '}) }}</span></p></div>
 <a href="{{ path('app_actions') }}" class="secondary link-button">Action history</a>
</div>
<section class="panel panel-content">
 <h2>Read-only action details</h2>
 <dl class="details">
  <div><dt>Operation</dt><dd>{{ is_link ? 'Reversible duplicate replacement with a symbolic link' : 'Reversible private quarantine' }}</dd></div>
  <div><dt>Original file</dt><dd><code>{{ batch.source_path }}</code></dd></div>
  <div><dt>Protected original copy</dt><dd><code>{{ batch.target_path }}</code></dd></div>
  {% if is_link %}<div><dt>Verified survivor / link target</dt><dd><code>{{ batch.link_target_path }}</code></dd></div>{% endif %}
  <div><dt>Recorded file size</dt><dd>{{ batch.expected_size|number_format }} bytes</dd></div>
  <div><dt>Verified SHA-256</dt><dd><code>{{ batch.expected_sha256 }}</code></dd></div>
  <div><dt>Requested (UTC)</dt><dd>{{ batch.requested_at }}</dd></div>
  <div><dt>Preview expires (UTC)</dt><dd>{{ batch.expires_at }}</dd></div>
  <div><dt>Status</dt><dd>{{ batch.state }}</dd></div>
  <div><dt>Result</dt><dd>{{ batch.result_code ?? batch.error_code ?? 'Awaiting confirmation' }}</dd></div>
 </dl>
 {% if batch.state == 'planned' %}
   <div class="notice notice-warning">
    <strong>Explicit approval is required.</strong>
    Both files are rechecked using complete SHA-256 hashes immediately before any mutation.
    {% if is_link %}
      The duplicate is first placed in the protected recovery directory; only then is
      the original path replaced by a symbolic link pointing to the verified survivor.
      The full original is retained for restoration.
    {% else %}
      The duplicate is moved into a protected recovery directory on the same filesystem.
    {% endif %}
    Existing target paths, changed files and unverified matches are refused.
   </div>
   <form method="post" action="{{ path('app_action_confirm',{id:batch.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('confirm_action_' ~ batch.id) }}">
    <div class="field"><label for="action-confirm">Type {{ approval }} to approve</label>
      <input id="action-confirm" name="confirm" required autocomplete="off" pattern="{{ approval }}"></div>
    <button type="submit" class="primary">Confirm {{ is_link ? 'link replacement' : 'quarantine' }}</button>
   </form>
 {% elseif batch.state == 'completed' %}
   <div class="notice">
     <strong>{{ is_link ? 'Link created.' : 'File quarantined.' }}</strong>
     The original file is retained under the private recovery path.
     {% if is_link %}Restoring removes only the expected link, verifies the stored original, and returns it without overwriting another file.{% endif %}
   </div>
   <form method="post" action="{{ path('app_action_restore',{id:batch.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('restore_action_' ~ batch.id) }}">
    <div class="field"><label for="restore-confirm">Type RESTORE to return the original file</label>
      <input id="restore-confirm" name="confirm" autocomplete="off" required pattern="RESTORE"></div>
    <button type="submit" class="secondary">Queue safe restore</button>
   </form>
 {% elseif batch.state == 'needs_review' %}
   <div class="notice notice-warning"><strong>Manual recovery required.</strong>
    Inspect the original, recovery and link paths and the audit history before attempting another operation.
    The worker will not overwrite any unexpected file.</div>
 {% else %}
   <p class="muted">Operation status: {{ batch.state|replace({'_':' '}) }}.
     Check the <a href="{{ path('app_jobs') }}">Job monitor</a> for progress.</p>
 {% endif %}
</section>
{% endblock %}
