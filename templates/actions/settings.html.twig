{% extends 'base.html.twig' %}
{% block title %}File actions settings{% endblock %}
{% block section %}Settings / File actions{% endblock %}
{% block body %}
<div class="page-heading">
  <div><div class="eyebrow">FILESYSTEM ACTION SETTINGS</div><h1>File exists</h1>
    <p class="muted">Default handling when moving or automatically renaming a file would collide with an existing destination filename.</p>
  </div>
  <a href="{{ path('app_actions') }}" class="secondary link-button">Action history</a>
</div>
<section class="panel panel-content">
  <form method="post" action="{{ path('app_action_settings_save') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('action_settings') }}">
    <div class="field">
      <label for="destination-exists">When destination file exists</label>
      <select name="destination_exists" id="destination-exists">
        <option value="fail" {{ policy == 'fail' ? 'selected' : '' }}>Fail — leave both files unchanged</option>
        <option value="number" {{ policy == 'number' ? 'selected' : '' }}>Append Number — file (1).ext, file (2).ext, etc.</option>
        <option value="overwrite" disabled>Overwrite — disabled (recovery safeguards required)</option>
      </select>
    </div>
    <p class="muted">Applied to new move previews and the default filename-cleanup preview setting. Manual filename edits and already-approved plans always use their exact approved target path. All operations still reject overwriting a destination that appears after preview.</p>
    <p class="muted">Link replacement deliberately keeps the original file privately for recovery. That procedure cannot use a general overwrite policy.</p>
    <button class="primary" type="submit">Save file action settings</button>
  </form>
</section>
{% endblock %}
