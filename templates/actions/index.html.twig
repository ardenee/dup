{% extends 'base.html.twig' %}
{% from '_table_headers.html.twig' import sort as sort_heading %}
{% block title %}File actions{% endblock %}
{% block section %}File actions{% endblock %}
{% block body %}
<div class="page-heading">
  <div>
    <div class="eyebrow">AUDITED FILE OPERATIONS</div>
    <h1>File action history</h1>
    <p class="muted">All recorded quarantine, link, move, restore and rename batches, including failures. Permanent deletion is available with explicit confirmation.</p>
  </div>
  <div class="profile-page-actions">
    <a href="{{ path('app_actions_cleanup') }}" class="secondary link-button">Clean old history</a>
    <a href="{{ path('app_duplicates') }}" class="secondary link-button">Browse duplicates</a>
  </div>
</div>
<section class="panel">
  <form method="get" action="{{ path('app_actions') }}" class="search-form">
    <div class="field">
      <label for="action-profile">Scan profile</label>
      <select id="action-profile" name="profile">
        <option value="">All profiles</option>
        {% for item in profiles %}
          <option value="{{ item.id }}" {{ profile == item.id ? 'selected' : '' }}>{{ item.name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="field">
      <label for="action-kind">Operation</label>
      <select id="action-kind" name="kind">
        <option value="">All operations</option>
        {% for option,label in {'quarantine':'Quarantine','link':'Link','move':'Move','rename':'Rename','bulk_quarantine':'Bulk quarantine','bulk_link':'Bulk link','delete':'Delete'} %}
          <option value="{{ option }}" {{ kind == option ? 'selected' : '' }}>{{ label }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="field">
      <label for="action-state">Batch status</label>
      <select id="action-state" name="state">
        <option value="">All statuses</option>
        {% for option in states %}
          <option value="{{ option }}" {{ state == option ? 'selected' : '' }}>{{ option|replace({'_':' '})|capitalize }}</option>
        {% endfor %}
      </select>
    </div>
    <input type="hidden" name="sort" value="{{ sort|default('id') }}">
    <input type="hidden" name="dir" value="{{ dir|default('desc') }}">
    <div class="search-actions">
      <button type="submit" class="primary">Filter</button>
      <a href="{{ path('app_actions') }}" class="secondary link-button">Clear</a>
    </div>
  </form>
</section>
<section class="panel">
  <div class="panel-heading">
    <h2>Recorded batches</h2>
    <span class="muted">{{ page.total|number_format }} matching batches</span>
  </div>
  {% if page.rows is empty %}
    <div class="empty-state">No action batches match this selection.</div>
    {% if page.total > 0 %}<div class="result-toolbar"><a href="{{ path('app_actions',filters) }}">Return to first page</a></div>{% endif %}
  {% else %}
    {% include 'actions/_pager.html.twig' %}
    <div class="table-wrap"><table>
      <thead><tr>
        {{ sort_heading('app_actions',filters|default({}),sort|default('id'),dir|default('desc'),'id','Batch / operation') }}
        {{ sort_heading('app_actions',filters|default({}),sort|default('id'),dir|default('desc'),'profile','Profile / source file') }}
        {{ sort_heading('app_actions',filters|default({}),sort|default('id'),dir|default('desc'),'files','Files') }}
        {{ sort_heading('app_actions',filters|default({}),sort|default('id'),dir|default('desc'),'status','Batch status') }}
        {{ sort_heading('app_actions',filters|default({}),sort|default('id'),dir|default('desc'),'requested','Requested (UTC)') }}
        {{ sort_heading('app_actions',filters|default({}),sort|default('id'),dir|default('desc'),'completed','Completed (UTC)') }}
        <th>Result</th><th>Manage</th>
      </tr></thead>
      <tbody>
      {% for batch in page.rows %}
        <tr>
          <td>
            <a class="text-link" href="{{ batch.action_kind == 'move' ? path('app_move_detail',{id:batch.id}) : path('app_action_detail',{id:batch.id}) }}">#{{ batch.id }} &mdash; {{ batch.action_kind|capitalize }}</a>
          </td>
          <td><strong>{{ batch.profile_name }}</strong>
            <div><code>{{ batch.source_path ?? 'Not recorded' }}</code></div>
          </td>
          <td>{{ batch.item_count|number_format }}
            {% if batch.state in ['completed','partial','failed','restored'] %}
              <small class="muted">{{ batch.successful_items|number_format }} {{ batch.action_kind == 'delete' ? 'deleted' : 'succeeded' }}{% if batch.failed_items > 0 %} · {{ batch.failed_items|number_format }} failed{% endif %}</small>
            {% endif %}
          </td>
          <td><span class="status">{{ batch.state|replace({'_':' '}) }}</span></td>
          <td>{{ batch.requested_at }}</td>
          <td>{{ batch.completed_at ?? 'Pending' }}</td>
          <td>{{ batch.error_code ?? '—' }}</td>
          <td><a class="text-link" href="{{ path('app_action_remove',{id:batch.id}) }}">Review / remove</a></td>
        </tr>
      {% endfor %}
      </tbody>
      <tfoot><tr><td colspan="5">Showing {{ page.rows|length }} of {{ page.total|number_format }} matching batches</td><td colspan="3">25 batches per page · server-wide sorting and filtering</td></tr></tfoot>
    </table></div>
    {% include 'actions/_pager.html.twig' %}
  {% endif %}
  <div class="result-toolbar">
    <span class="muted">Each batch opens its recorded details; no filesystem changes occur by browsing history.</span>
  </div>
</section>
{% endblock %}
