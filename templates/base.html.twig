<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>{% block title %}DUP{% endblock %} · Duplicate Manager</title>
  <link rel="stylesheet" href="{{ asset('assets/app.css') }}?v=0.7.19-heartbeat">
  {% block page_styles %}{% endblock %}
  <link rel="icon" type="image/png" sizes="120x120" href="{{ asset('assets/dup.png') }}">
</head>
<body>
  {% include "_action_sprite.html.twig" %}
  <a class="skip-link" href="#content">Skip to content</a>
  <div class="app-shell">
  {% if app.user %}
    <aside class="sidebar" aria-label="Application navigation">
      <div class="brand"><img class="brand-logo-original" src="{{ asset('assets/dup.png') }}" width="32" height="32" alt="DUP icon"><div><strong>DUP</strong><small>Duplicate Manager</small></div></div>
      <nav aria-label="Main navigation">
      {% set last_section = '' %}
      {% set nav_labels = {'overview':'OVERVIEW','find':'FIND FILES','scan':'SCAN & MONITOR','actions':'FILE OPERATIONS','settings':'SETTINGS'} %}
      {% for link in dup_navigation() %}
        {% if is_granted('ROLE_ADMIN') or link.route in ['app_dashboard','app_duplicates','app_search','app_reports'] %}
          {% set nav_section = link.section|default('other') %}
          {% if nav_section != last_section %}
            <div class="nav-section-heading">{{ nav_labels[nav_section]|default(nav_section|replace({'_':' '})|title) }}</div>
            {% set last_section = nav_section %}
          {% endif %}
          {% set destination = path(link.route) %}
          {% set is_active = app.request.attributes.get('_route') == link.route or (destination != '/' and app.request.pathInfo starts with destination ~ '/') %}
          <a href="{{ destination }}" class="nav-link {{ is_active ? 'active' : '' }}" {{ is_active ? 'aria-current="page"' : '' }}>{{ link.label }}</a>
        {% endif %}
      {% endfor %}
      </nav>
      <div class="sidebar-bottom">
        <span class="account-name">{{ app.user.userIdentifier }}</span>
        <form method="post" action="{{ path('app_logout') }}">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
          <button class="signout" type="submit">Sign out</button>
        </form>
        <span class="version">0.7.19</span>
      </div>
    </aside>
  {% endif %}
  <div class="content-wrap {{ app.user ? '' : 'guest' }}">
    <header class="topbar">
      <span class="topbar-name">DUP <span class="topbar-muted">/ {% block section %}Overview{% endblock %}</span></span>
      <span class="environment">{{ app.environment|upper }}</span>
    </header>
    <main class="main" id="content">
      {% for label, messages in app.flashes %}
        {% for message in messages %}
          <div class="notice notice-{{ label }}" role="status">{{ message }}</div>
        {% endfor %}
      {% endfor %}
      {% block body %}{% endblock %}
    </main>
    <footer class="app-footer">DUP 0.7.19 · Audited filesystem actions require explicit approval · <a href="{{ asset('assets/license.txt') }}">MIT License</a></footer>
  </div>
  </div>
  <script type="module" src="{{ asset('assets/table-local.js') }}?v=1"></script>
</body>
</html>
