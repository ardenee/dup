# Configure PHP-FPM socket and hostname for your Linux distribution.
# The application, vendor, migrations, .env.local and var/ stay outside
# the HTTP document root.
server {
    listen 443 ssl;
    server_name dup.example.test;
    root /srv/dup/public;
    index index.php;
    # Configure ssl_certificate / ssl_certificate_key in the real server.
    location / {
        try_files $uri /index.php$is_args$args;
    }
    location ~ ^/(index|setup)\.php(/|$) {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        try_files $uri =404;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known) { deny all; }
}
