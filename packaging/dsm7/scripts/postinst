#!/bin/sh
set -eu
umask 077
APP="${SYNOPKG_PKGDEST:-/var/packages/dup/target}/app"
VAR="${SYNOPKG_PKGVAR:-/var/packages/dup/var}"
mkdir -p "$VAR/runtime"
if [ ! -e "$APP/var" ] && [ ! -L "$APP/var" ]; then
    ln -s "$VAR/runtime" "$APP/var"
fi
# A first-run setup must supply a private .env.local. It survives package upgrades.
if [ ! -e "$APP/.env.local" ] && [ ! -L "$APP/.env.local" ]; then
    ln -s "$VAR/.env.local" "$APP/.env.local"
fi
# The Web Station PHP service uses dup:http. DSM creates the package
# worker with dup:dup, so supplement its group membership to read the
# same shared folders. This does not change any share ACL or replace
# existing http group members.
if [ "$(id -u)" -eq 0 ] && [ -x /usr/syno/sbin/synogroup ]; then
    if ! id -nG dup | tr ' ' '\n' | grep -qx 'http'; then
        /usr/syno/sbin/synogroup --memberadd http dup >/dev/null 2>&1 || :
    fi
fi
if ! id -nG dup | tr ' ' '\n' | grep -qx 'http'; then
    echo 'DUP: package user dup needs supplementary http group membership for scan folders.' >&2
fi
exit 0
