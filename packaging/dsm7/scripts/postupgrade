#!/bin/sh
set -eu
umask 077

APP="${SYNOPKG_PKGDEST:-/var/packages/dup/target}/app"
VAR="${SYNOPKG_PKGVAR:-/var/packages/dup/var}"

mkdir -p "$VAR/runtime"
if [ ! -e "$APP/var" ] && [ ! -L "$APP/var" ]; then
    ln -s "$VAR/runtime" "$APP/var"
fi
if [ ! -e "$APP/.env.local" ] && [ ! -L "$APP/.env.local" ]; then
    ln -s "$VAR/.env.local" "$APP/.env.local"
fi

# Only update a previously configured DUP v2 database. New installations
# continue through the setup wizard. Do not import legacy databases here.
if [ ! -f "$VAR/runtime/setup.complete" ]; then
    echo "DUP: no completed setup; skipping upgrade migrations"
    exit 0
fi
if [ ! -r "$VAR/.env.local" ]; then
    echo "DUP: private database configuration is missing; upgrade stopped" >&2
    exit 1
fi

find_php() {
    for php in \
        "${DUP_PHP_BIN:-}" \
        /var/packages/PHP8.4/target/usr/local/bin/php84 \
        /var/packages/PHP8.2/target/usr/local/bin/php82 \
        /usr/local/bin/php84 \
        /usr/local/bin/php82 \
        /usr/bin/php
    do
        [ -n "$php" ] && [ -x "$php" ] || continue
        if "$php" -r 'exit(PHP_VERSION_ID >= 80200 ? 0 : 1);' >/dev/null 2>&1; then
            printf '%s\n' "$php"
            return 0
        fi
    done
    return 1
}

PHP="$(find_php)" || {
    echo "DUP: no PHP 8.2+ CLI binary available for schema upgrade" >&2
    exit 1
}
if [ ! -f "$APP/bin/console" ] || [ ! -d "$APP/migrations" ]; then
    echo "DUP: incomplete application payload; migration aborted" >&2
    exit 1
fi

cd "$APP"
echo "DUP: applying additive v2 database migrations"
"$PHP" bin/console doctrine:migrations:migrate \
    --env=prod --no-debug --no-interaction --no-ansi
echo "DUP: rebuilding production application cache"
"$PHP" bin/console cache:clear --env=prod --no-debug --no-ansi
echo "DUP: database migrations and cache completed successfully"
exit 0
