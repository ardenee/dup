#!/bin/sh
set -eu
APP="${SYNOPKG_PKGDEST:-/var/packages/dupv2/target}/app"
VAR="${SYNOPKG_PKGVAR:-/var/packages/dupv2/var}"
PID="$VAR/worker.pid"

running() {
    [ -f "$PID" ] || return 1
    pid=$(cat "$PID" 2>/dev/null || true)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
    prestart|prestop) exit 0 ;;
    start)
        umask 077
        mkdir -p "$VAR"
        if running; then exit 0; fi
        rm -f "$PID"
        [ -f "$APP/worker-loop.sh" ] || exit 1
        nohup /bin/sh "$APP/worker-loop.sh" "$APP" "$VAR" >>"$VAR/worker.log" 2>&1 &
        echo "$!" > "$PID"
        exit 0
        ;;
    stop)
        if running; then
            pid=$(cat "$PID")
            kill "$pid" 2>/dev/null || true
        fi
        rm -f "$PID"
        exit 0
        ;;
    status)
        running
        ;;
    *) exit 1 ;;
esac
