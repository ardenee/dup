{
  "webservice": {
    "services": [
      {
        "service": "dup",
        "display_name": "DUP 0.7.5 Preview",
        "support_alias": true,
        "support_server": false,
        "type": "nginx_php",
        "root": "dup",
        "index": ["index.php"],
        "custom_rule": {
          "global_rule": "/var/packages/dup/target/app/misc/nginx_global.mustache"
        },
        "php": {
          "profile_name": "DUP PHP",
          "profile_desc": "DUP PHP profile",
          "backend": __PHP_BACKEND__,
          "open_basedir": "/var/services/web_packages/dup:/var/packages/dup/target/app:/var/packages/dup/var:/volume1:/volume2:/volume3:/volume4:/run/mysqld:/tmp:/var/services/tmp",
          "extensions": ["pdo_mysql", "mbstring", "intl", "iconv", "openssl", "fileinfo", "xml"],
          "user": "dup",
          "group": "http"
        },
        "connect_timeout": 30,
        "read_timeout": 120,
        "send_timeout": 30
      }
    ],
    "portals": [
      {
        "service": "dup",
        "name": "dup",
        "display_name": "DUP 0.7.5 Preview",
        "type": "alias",
        "alias": "dup"
      }
    ],
    "pkg_dir_prepare": [
      {
        "source": "/var/packages/dup/target/webapp",
        "target": "dup",
        "mode": "0755",
        "user": "dup",
        "group": "http"
      }
    ]
  }
}
