{
  "webservice": {
    "services": [
      {
        "service": "dup",
        "display_name": "DUP",
        "support_alias": true,
        "support_server": false,
        "type": "nginx_php",
        "root": "dup",
        "index": [
          "index.php"
        ],
        "php": {
          "profile_name": "DUP PHP 8.2",
          "profile_desc": "DUP package PHP 8.2 profile",
          "backend": 11,
          "open_basedir": "/var/services/web_packages/dup:/var/packages/dup/var:/volume1:/volume2:/volume3:/volume4:/tmp:/var/services/tmp",
          "extensions": [
            "pdo_mysql",
            "pdo_sqlite",
            "sqlite3",
            "mbstring",
            "curl",
            "fileinfo"
          ],
          "user": "dup",
          "group": "http"
        },
        "connect_timeout": 30,
        "read_timeout": 120,
        "send_timeout": 30
      }
    ],
    "portals": [
      {
        "service": "dup",
        "name": "dup",
        "display_name": "DUP",
        "type": "alias",
        "alias": "dup"
      }
    ],
    "pkg_dir_prepare": [
      {
        "source": "/var/packages/dup/target/webapp",
        "target": "dup",
        "mode": "0755",
        "user": "dup",
        "group": "http"
      }
    ]
  }
}
