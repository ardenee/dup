{{#alias}}
# DUP's Symfony routes need an Nginx front-controller rewrite.
# Keep real PHP frontends and static assets served normally.
# "rewrite" is valid in either server or location context in Web Station.
rewrite ^/dup/(?!index\.php(?:/|$)|setup\.php(?:/|$)|assets/|license\.txt$)(.+)$ /dup/index.php last;
{{/alias}}
