# Runtime state and generated data
/logs/*
!/logs/.gitkeep
/backup/*
!/backup/.gitkeep
/dist/

# Reference copies are retained locally, not deployed or tracked
/orignal/
/old/
/dup2/

# Local database files (never ship populated databases)
/dup.db
/dup.sqlite
/files/*.db
/files/*.sqlite
/images/*.db
/images/*.sqlite
*.db-journal
*.db-wal
*.db-shm

# Machine-specific configuration and secrets
/config.local.php
/db.local.php
/.env
/.env.*
!/config.sample.php

# OS, editor and temporary files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
__pycache__/
*.pyc
*.tmp
*.bak
*.old
*.swp
*.log
